@model VDK_BookRental.ViewModels.ProfilePageViewModel

@{
    ViewData["Title"] = "Hồ sơ cá nhân";

    // Không phụ thuộc Session AvatarUrl nữa.
    // URL ảnh được tạo trực tiếp từ UserId nên cập nhật
    // avatar sẽ đồng bộ trên mọi trang sau khi reload.
    var avatarUrl =
        Url.Action(
            "Avatar",
            "Profile",
            new
            {
                userId = Model.UserId
            }
        );

    var fullNameForInitials =
        string.IsNullOrWhiteSpace(
            Model.FullName)
            ? Model.UserName
            : Model.FullName;

    var initials =
        string.Join(
            "",
            fullNameForInitials
                .Split(
                    ' ',
                    StringSplitOptions
                        .RemoveEmptyEntries
                )
                .TakeLast(2)
                .Select(word =>
                    char.ToUpperInvariant(
                        word[0]))
        );

    if (string.IsNullOrWhiteSpace(
        initials))
    {
        initials = "U";
    }

    string GetRoleText(
        string? role)
    {
        return role switch
        {
            "Admin" =>
                "Quản trị viên",

            "Staff" =>
                "Nhân viên",

            "Customer" =>
                "Khách hàng",

            _ =>
                role ??
                "Người dùng"
        };
    }

    string GetRoleClass(
        string? role)
    {
        return role switch
        {
            "Admin" =>
                "profile-role-admin",

            "Staff" =>
                "profile-role-staff",

            _ =>
                "profile-role-customer"
        };
    }
}

<style>
    .profile-page {
        min-height: 100vh;
        padding: 34px 0 64px;
        background: radial-gradient( circle at top right, rgba(13, 110, 253, 0.11), transparent 31% ), #f5f7fb;
    }

    .profile-heading {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 24px;
    }

        .profile-heading h1 {
            margin: 0;
            color: #172033;
            font-size: clamp( 1.8rem, 3vw, 2.45rem );
            font-weight: 900;
        }

        .profile-heading p {
            margin: 8px 0 0;
            color: #6c757d;
        }

    .profile-back-button {
        min-height: 46px;
        padding: 11px 18px;
        border-radius: 13px;
        font-weight: 800;
    }

    .profile-user-card {
        overflow: hidden;
        border: none;
        border-radius: 24px;
        background: #ffffff;
        box-shadow: 0 14px 38px rgba(24, 39, 75, 0.1);
    }

    .profile-cover {
        height: 135px;
        background: linear-gradient( 135deg, #0d6efd, #111827 );
    }

    .profile-user-body {
        padding: 0 24px 25px;
        text-align: center;
    }

    .profile-avatar {
        width: 112px;
        height: 112px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-top: -56px;
        overflow: hidden;
        border: 6px solid #ffffff;
        border-radius: 50%;
        color: #ffffff;
        background: linear-gradient( 135deg, #0d6efd, #6f42c1 );
        box-shadow: 0 12px 28px rgba(13, 110, 253, 0.25);
        font-size: 2rem;
        font-weight: 900;
    }

    .profile-avatar {
        position: relative;
    }

        .profile-avatar img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
        }

    .profile-avatar-upload {
        margin-top: 16px;
        padding: 14px;
        border: 1px dashed #cbd5e1;
        border-radius: 16px;
        background: #f8fafc;
        text-align: left;
    }

    .profile-avatar-upload-title {
        margin-bottom: 8px;
        color: #334155;
        font-size: 0.88rem;
        font-weight: 850;
    }

    .profile-avatar-help {
        margin: 7px 0 0;
        color: #7a8494;
        font-size: 0.75rem;
        line-height: 1.45;
    }

    .profile-avatar-button {
        width: 100%;
        min-height: 42px;
        margin-top: 10px;
        border-radius: 12px;
        font-weight: 800;
    }

    .profile-name {
        margin: 15px 0 4px;
        color: #172033;
        font-size: 1.45rem;
        font-weight: 900;
    }

    .profile-username {
        color: #7a8494;
        font-size: 0.92rem;
    }

    .profile-role {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 13px;
        padding: 7px 12px;
        border-radius: 999px;
        font-size: 0.83rem;
        font-weight: 850;
    }

    .profile-role-admin {
        color: #842029;
        background: #f8d7da;
    }

    .profile-role-staff {
        color: #084298;
        background: #cfe2ff;
    }

    .profile-role-customer {
        color: #146c43;
        background: #d1e7dd;
    }

    .profile-account-status {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        margin-top: 12px;
        color: #198754;
        font-size: 0.87rem;
        font-weight: 750;
    }

        .profile-account-status.locked {
            color: #dc3545;
        }

    .profile-stat-grid {
        display: grid;
        grid-template-columns: repeat( 2, minmax(0, 1fr) );
        gap: 11px;
        margin-top: 23px;
    }

    .profile-stat {
        padding: 14px 10px;
        border: 1px solid #edf0f4;
        border-radius: 15px;
        background: #fbfcfe;
    }

    .profile-stat-value {
        color: #172033;
        font-size: 1.2rem;
        font-weight: 900;
    }

    .profile-stat-label {
        margin-top: 3px;
        color: #7a8494;
        font-size: 0.78rem;
        font-weight: 650;
    }

    .profile-form-card {
        height: 100%;
        padding: 25px;
        border: none;
        border-radius: 22px;
        background: #ffffff;
        box-shadow: 0 12px 34px rgba(24, 39, 75, 0.08);
    }

    .profile-form-header {
        margin-bottom: 21px;
    }

        .profile-form-header h2 {
            margin: 0;
            color: #172033;
            font-size: 1.3rem;
            font-weight: 900;
        }

        .profile-form-header p {
            margin: 7px 0 0;
            color: #6c757d;
        }

    .profile-label {
        color: #344054;
        font-weight: 800;
    }

    .profile-control {
        min-height: 49px;
        border-radius: 13px;
    }

    .profile-readonly {
        background: #f1f3f5;
    }

    .profile-submit-button {
        min-height: 48px;
        border-radius: 13px;
        font-weight: 850;
    }

    .profile-password-wrapper {
        position: relative;
    }

        .profile-password-wrapper
        .profile-control {
            padding-right: 49px;
        }

    .profile-password-toggle {
        position: absolute;
        top: 50%;
        right: 10px;
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        border-radius: 10px;
        color: #6c757d;
        background: transparent;
        transform: translateY(-50%);
    }

    .profile-security-note {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 19px;
        padding: 14px 15px;
        border: 1px solid #b6effb;
        border-radius: 14px;
        color: #055160;
        background: #cff4fc;
        font-size: 0.88rem;
    }

    @@media (
            max-width: 767.98px
        ) {
        .profile-page {
            padding-top: 22px;
        }

        .profile-heading {
            align-items: stretch;
        }

        .profile-back-button {
            width: 100%;
        }
    }
</style>

<div class="profile-page">
    <div class="container">

        <div class="profile-heading">

            <div>
                <h1>
                    <i class="bi bi-person-circle me-2 text-primary"></i>
                    Hồ sơ cá nhân
                </h1>

                <p>
                    Cập nhật thông tin tài khoản,
                    ảnh đại diện và bảo vệ mật khẩu đăng nhập.
                </p>
            </div>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-primary profile-back-button">

                <i class="bi bi-house-door me-2"></i>
                Về trang chủ
            </a>

        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm"
                 role="alert">

                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Đóng">
                </button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm"
                 role="alert">

                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @TempData["ErrorMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Đóng">
                </button>
            </div>
        }

        <div class="row g-4">

            <div class="col-12 col-lg-4">

                <div class="profile-user-card">

                    <div class="profile-cover">
                    </div>

                    <div class="profile-user-body">

                        <div class="profile-avatar"
                             id="profileAvatarPreview">

                            <span id="profileAvatarFallback">
                                @initials
                            </span>

                            @if (!string.IsNullOrWhiteSpace(
                                avatarUrl))
                            {
                                <img src="@avatarUrl"
                                     alt="Ảnh đại diện"
                                     id="profileAvatarImage"
                                     onerror="this.style.display='none';" />
                            }

                        </div>

                        <div class="profile-name">
                            @Model.FullName
                        </div>

                        <div class="profile-username">
                            @@Model.UserName
                        </div>

                        <span class="profile-role @GetRoleClass(Model.Role)">

                            <i class="bi bi-shield-check">
                            </i>

                            @GetRoleText(Model.Role)
                        </span>

                        <div class="profile-account-status @(Model.IsLocked ? "locked" : "")">

                            <i class="bi @(Model.IsLocked
                                                               ? "bi-lock-fill"
                                                               : "bi-check-circle-fill")">
                            </i>

                            @(Model.IsLocked
                                ? "Tài khoản đang bị khóa"
                                : "Tài khoản đang hoạt động")
                        </div>

                        <form asp-controller="Profile"
                              asp-action="UploadAvatar"
                              method="post"
                              enctype="multipart/form-data"
                              class="profile-avatar-upload"
                              id="avatarUploadForm">

                            @Html.AntiForgeryToken()

                            <div class="profile-avatar-upload-title">

                                <i class="bi bi-camera-fill me-1">
                                </i>

                                Ảnh đại diện
                            </div>

                            <input type="file"
                                   id="avatarFile"
                                   name="avatarFile"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                   class="form-control"
                                   required />

                            <p class="profile-avatar-help">
                                Hỗ trợ JPG, JPEG, PNG, WEBP.
                                Dung lượng tối đa 5 MB.
                            </p>

                            <button type="submit"
                                    class="btn btn-primary profile-avatar-button"
                                    id="uploadAvatarButton">

                                <i class="bi bi-cloud-arrow-up-fill me-1">
                                </i>

                                Cập nhật ảnh đại diện
                            </button>

                        </form>

                        <div class="profile-stat-grid">

                            <div class="profile-stat">

                                <div class="profile-stat-value">
                                    @Model.TotalRentals
                                </div>

                                <div class="profile-stat-label">
                                    Tổng đơn thuê
                                </div>

                            </div>

                            <div class="profile-stat">

                                <div class="profile-stat-value">
                                    @Model.BorrowingRentals
                                </div>

                                <div class="profile-stat-label">
                                    Đang thuê
                                </div>

                            </div>

                            <div class="profile-stat">

                                <div class="profile-stat-value">
                                    @Model.ReturnedRentals
                                </div>

                                <div class="profile-stat-label">
                                    Đã trả
                                </div>

                            </div>

                            <div class="profile-stat">

                                <div class="profile-stat-value fs-6">
                                    @Model.TotalSpent.ToString("N0")
                                </div>

                                <div class="profile-stat-label">
                                    Đã thanh toán (VNĐ)
                                </div>

                            </div>

                        </div>

                    </div>
                </div>

            </div>

            <div class="col-12 col-lg-8">

                <div class="profile-form-card mb-4">

                    <div class="profile-form-header">

                        <h2>
                            <i class="bi bi-person-lines-fill me-2 text-primary">
                            </i>

                            Thông tin cá nhân
                        </h2>

                        <p>
                            Tên đăng nhập và quyền tài khoản
                            không thể tự thay đổi.
                        </p>

                    </div>

                    <form asp-controller="Profile"
                          asp-action="Update"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="row g-3">

                            <div class="col-12 col-md-6">

                                <label class="form-label profile-label">
                                    Tên đăng nhập
                                </label>

                                <input value="@Model.UserName"
                                       class="form-control profile-control profile-readonly"
                                       readonly />

                            </div>

                            <div class="col-12 col-md-6">

                                <label class="form-label profile-label">
                                    Quyền tài khoản
                                </label>

                                <input value="@GetRoleText(Model.Role)"
                                       class="form-control profile-control profile-readonly"
                                       readonly />

                            </div>

                            <div class="col-12">

                                <label for="fullName"
                                       class="form-label profile-label">
                                    Họ và tên
                                </label>

                                <input id="fullName"
                                       name="FullName"
                                       value="@Model.FullName"
                                       class="form-control profile-control"
                                       minlength="2"
                                       maxlength="100"
                                       required />

                            </div>

                            <div class="col-12 col-md-6">

                                <label for="email"
                                       class="form-label profile-label">
                                    Email
                                </label>

                                <input id="email"
                                       name="Email"
                                       type="email"
                                       value="@Model.Email"
                                       class="form-control profile-control"
                                       maxlength="150"
                                       required />

                            </div>

                            <div class="col-12 col-md-6">

                                <label for="phone"
                                       class="form-label profile-label">
                                    Số điện thoại
                                </label>

                                <input id="phone"
                                       name="Phone"
                                       type="tel"
                                       value="@Model.Phone"
                                       class="form-control profile-control"
                                       maxlength="10"
                                       pattern="0[0-9]{9}"
                                       placeholder="Ví dụ: 0901234567" />

                            </div>

                            <div class="col-12">

                                <button type="submit"
                                        class="btn btn-primary profile-submit-button px-4">

                                    <i class="bi bi-check-lg me-2">
                                    </i>

                                    Lưu thông tin
                                </button>

                            </div>

                        </div>

                    </form>

                </div>

                <div class="profile-form-card">

                    <div class="profile-form-header">

                        <h2>
                            <i class="bi bi-key-fill me-2 text-warning">
                            </i>

                            Đổi mật khẩu
                        </h2>

                        <p>
                            Mật khẩu mới phải có ít nhất 6 ký tự
                            và khác mật khẩu hiện tại.
                        </p>

                    </div>

                    <div class="profile-security-note">

                        <i class="bi bi-shield-lock-fill">
                        </i>

                        <div>
                            Mật khẩu được băm bằng BCrypt
                            trước khi lưu vào cơ sở dữ liệu.
                        </div>

                    </div>

                    <form asp-controller="Profile"
                          asp-action="ChangePassword"
                          method="post"
                          id="changePasswordForm">

                        @Html.AntiForgeryToken()

                        <div class="row g-3">

                            <div class="col-12">

                                <label for="currentPassword"
                                       class="form-label profile-label">
                                    Mật khẩu hiện tại
                                </label>

                                <div class="profile-password-wrapper">

                                    <input id="currentPassword"
                                           name="CurrentPassword"
                                           type="password"
                                           class="form-control profile-control"
                                           autocomplete="current-password"
                                           required />

                                    <button type="button"
                                            class="profile-password-toggle"
                                            data-password-target="currentPassword"
                                            aria-label="Hiện hoặc ẩn mật khẩu">

                                        <i class="bi bi-eye">
                                        </i>

                                    </button>

                                </div>

                            </div>

                            <div class="col-12 col-md-6">

                                <label for="newPassword"
                                       class="form-label profile-label">
                                    Mật khẩu mới
                                </label>

                                <div class="profile-password-wrapper">

                                    <input id="newPassword"
                                           name="NewPassword"
                                           type="password"
                                           class="form-control profile-control"
                                           minlength="6"
                                           autocomplete="new-password"
                                           required />

                                    <button type="button"
                                            class="profile-password-toggle"
                                            data-password-target="newPassword"
                                            aria-label="Hiện hoặc ẩn mật khẩu">

                                        <i class="bi bi-eye">
                                        </i>

                                    </button>

                                </div>

                            </div>

                            <div class="col-12 col-md-6">

                                <label for="confirmPassword"
                                       class="form-label profile-label">
                                    Xác nhận mật khẩu mới
                                </label>

                                <div class="profile-password-wrapper">

                                    <input id="confirmPassword"
                                           name="ConfirmPassword"
                                           type="password"
                                           class="form-control profile-control"
                                           minlength="6"
                                           autocomplete="new-password"
                                           required />

                                    <button type="button"
                                            class="profile-password-toggle"
                                            data-password-target="confirmPassword"
                                            aria-label="Hiện hoặc ẩn mật khẩu">

                                        <i class="bi bi-eye">
                                        </i>

                                    </button>

                                </div>

                            </div>

                            <div class="col-12">

                                <button type="submit"
                                        class="btn btn-warning profile-submit-button px-4">

                                    <i class="bi bi-key me-2">
                                    </i>

                                    Đổi mật khẩu
                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>
</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document
        .querySelectorAll(
        "[data-password-target]"
        )
        .forEach(function (button) {

        button.addEventListener(
        "click",
        function () {

        const targetId =
        button.getAttribute(
        "data-password-target"
        );

        const input =
        document.getElementById(
        targetId
        );

        const icon =
        button.querySelector(
        "i"
        );

        if (!input) {
        return;
        }

        const shouldShow =
        input.type ===
        "password";

        input.type =
        shouldShow
        ? "text"
        : "password";

        if (icon) {
        icon.className =
        shouldShow
        ? "bi bi-eye-slash"
        : "bi bi-eye";
        }
        }
        );
        });

        const changePasswordForm =
        document.getElementById(
        "changePasswordForm"
        );

        changePasswordForm
        ?.addEventListener(
        "submit",
        function (event) {

        const newPassword =
        document
        .getElementById(
        "newPassword"
        )
        ?.value ?? "";

        const confirmPassword =
        document
        .getElementById(
        "confirmPassword"
        )
        ?.value ?? "";

        if (
        newPassword !==
        confirmPassword
        ) {
        event.preventDefault();

        if (
        typeof Swal !==
        "undefined"
        ) {
        Swal.fire({
        title:
        "Mật khẩu không khớp",
        text:
        "Vui lòng nhập lại phần xác nhận mật khẩu.",
        icon:
        "warning",
        confirmButtonText:
        "Đã hiểu"
        });
        }
        }
        }
        );

        const avatarInput =
        document.getElementById(
        "avatarFile"
        );

        const avatarPreview =
        document.getElementById(
        "profileAvatarPreview"
        );

        avatarInput
        ?.addEventListener(
        "change",
        function () {

        const file =
        avatarInput
        .files?.[0];

        if (
        !file ||
        !avatarPreview
        ) {
        return;
        }

        const allowedTypes = [
        "image/jpeg",
        "image/png",
        "image/webp"
        ];

        const maxSize =
        5 * 1024 * 1024;

        if (
        !allowedTypes
        .includes(
        file.type)
        ) {
        avatarInput.value =
        "";

        if (
        typeof Swal !==
        "undefined"
        ) {
        Swal.fire({
        title:
        "Ảnh không hợp lệ",
        text:
        "Chỉ chấp nhận JPG, JPEG, PNG hoặc WEBP.",
        icon:
        "warning",
        confirmButtonText:
        "Đã hiểu"
        });
        }

        return;
        }

        if (
        file.size >
        maxSize
        ) {
        avatarInput.value =
        "";

        if (
        typeof Swal !==
        "undefined"
        ) {
        Swal.fire({
        title:
        "Ảnh quá lớn",
        text:
        "Dung lượng ảnh tối đa là 5 MB.",
        icon:
        "warning",
        confirmButtonText:
        "Đã hiểu"
        });
        }

        return;
        }

        const objectUrl =
        URL.createObjectURL(
        file
        );

        avatarPreview
        .innerHTML =
        "";

        const image =
        document
        .createElement(
        "img"
        );

        image.src =
        objectUrl;

        image.alt =
        "Xem trước ảnh đại diện";

        image.onload =
        function () {
        URL.revokeObjectURL(
        objectUrl
        );
        };

        avatarPreview
        .appendChild(
        image
        );
        }
        );

        const avatarUploadForm =
        document.getElementById(
        "avatarUploadForm"
        );

        const uploadAvatarButton =
        document.getElementById(
        "uploadAvatarButton"
        );

        avatarUploadForm
        ?.addEventListener(
        "submit",
        function () {

        if (
        !uploadAvatarButton
        ) {
        return;
        }

        uploadAvatarButton
        .disabled =
        true;

        uploadAvatarButton
        .innerHTML =
        '<span class="spinner-border spinner-border-sm me-2"></span>Đang tải ảnh...';
        }
        );
    </script>
}
