@{
    ViewData["Title"] = "Gửi yêu cầu thanh toán thành công";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-lg rounded-4">

                <div class="card-body text-center p-5">

                    <div class="display-3 mb-3">
                        ✅
                    </div>

                    <h1 class="fw-bold text-success mb-3">
                        Đã gửi xác nhận thanh toán
                    </h1>

                    <p class="fs-5 text-muted">
                        Hệ thống đã ghi nhận thông tin chuyển khoản của bạn.
                    </p>

                    <div class="alert alert-warning mt-4">

                        Thanh toán đang chờ quản trị viên kiểm tra và xác nhận.

                    </div>

                    <div class="d-flex justify-content-center
                        gap-3 flex-wrap mt-4">

                        <a asp-controller="Rental"
                           asp-action="History"
                           class="btn btn-primary btn-lg">

                            Xem lịch sử thuê

                        </a>

                        <a asp-controller="Books"
                           asp-action="Index"
                           class="btn btn-outline-secondary btn-lg">

                            Tiếp tục xem sách

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>