@model IEnumerable<VDK_BookRental.Models.Rental>

@{
    ViewData["Title"] = "Sách đang thuê";

    var rentals =
        Model?.ToList()
        ?? new List<VDK_BookRental.Models.Rental>();

    string RentalStatusText(string? status)
    {
        return status switch
        {
            "Pending" => "Chờ duyệt",
            "Approved" => "Đã duyệt",
            "Borrowing" => "Đang thuê",
            "Returned" => "Đã trả",
            "Cancelled" => "Đã hủy",
            _ => status ?? "Không xác định"
        };
    }

    string RentalStatusClass(string? status)
    {
        return status switch
        {
            "Pending" => "bg-warning text-dark",
            "Approved" => "bg-primary",
            "Borrowing" => "bg-info text-dark",
            "Returned" => "bg-success",
            "Cancelled" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    string PaymentStatusText(string? status)
    {
        return status switch
        {
            "Pending" => "Chờ thanh toán",
            "AwaitingConfirmation" => "Chờ xác nhận",
            "Paid" => "Đã thanh toán",
            "Completed" => "Đã hoàn tất",
            "Rejected" => "Bị từ chối",
            "Cancelled" => "Đã hủy",
            _ => "Chưa thanh toán"
        };
    }

    bool CanPay(
        string? paymentStatus,
        string? rentalStatus)
    {
        if (rentalStatus == "Returned" ||
            rentalStatus == "Cancelled")
        {
            return false;
        }

        return string.IsNullOrWhiteSpace(paymentStatus)
               || paymentStatus == "Pending"
               || paymentStatus == "Rejected";
    }

    bool CanCancel(
        string? paymentStatus,
        string? rentalStatus)
    {
        return rentalStatus == "Pending"
               && paymentStatus != "Paid"
               && paymentStatus != "Completed"
               && paymentStatus !=
                    "AwaitingConfirmation";
    }
}

<div class="container py-5">

    <div class="d-flex flex-wrap
        justify-content-between
        align-items-center
        gap-3 mb-4">

        <div>

            <h1 class="fw-bold mb-1">

                <i class="bi bi-book-half text-primary me-2">
                </i>

                Sách đang thuê

            </h1>

            <p class="text-muted mb-0">

                Theo dõi các đơn chờ duyệt,
                đã duyệt và đang thuê.

            </p>

        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Books"
               asp-action="Index"
               class="btn btn-primary">

                <i class="bi bi-book me-1"></i>
                Xem thêm sách

            </a>

            <a asp-controller="Rental"
               asp-action="History"
               class="btn btn-outline-primary">

                <i class="bi bi-clock-history me-1"></i>
                Lịch sử

            </a>

        </div>

    </div>

    @if (ViewBag.LoadError != null)
    {
        <div class="alert alert-danger">

            <i class="bi bi-exclamation-triangle-fill me-2">
            </i>

            @ViewBag.LoadError

        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success
            alert-dismissible fade show">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info
            alert-dismissible fade show">

            @TempData["InfoMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger
            alert-dismissible fade show">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (!rentals.Any())
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body
                text-center
                py-5">

                <div class="display-3 mb-3">
                    📚
                </div>

                <h3 class="fw-bold">
                    Chưa có sách đang thuê
                </h3>

                <p class="text-muted">

                    Các đơn chờ duyệt, đã duyệt
                    hoặc đang thuê sẽ xuất hiện tại đây.

                </p>

                <a asp-controller="Books"
                   asp-action="Index"
                   class="btn btn-primary px-4">

                    Khám phá sách

                </a>

            </div>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var rental in rentals)
            {
                var paymentStatus =
                    rental.Payment?.Status;

                var details =
                    rental.RentalDetails?.ToList()
                    ?? new List<
                        VDK_BookRental.Models.RentalDetail>();

                var remainingDays =
                    (rental.ReturnDate.Date -
                     DateTime.Today).Days;

                <div class="col-12">

                    <article class="card
                        border-0
                        shadow-sm
                        overflow-hidden">

                        <div class="card-header
                            bg-white
                            d-flex
                            flex-wrap
                            justify-content-between
                            align-items-center
                            gap-3
                            py-3">

                            <div>

                                <h5 class="fw-bold
                                    text-primary
                                    mb-1">

                                    #RENT-@rental.Id.ToString("D4")

                                </h5>

                                <small class="text-muted">

                                    Ngày tạo:
                                    @rental.RentalDate.ToString("dd/MM/yyyy")

                                </small>

                            </div>

                            <div class="d-flex
                                flex-wrap
                                gap-2">

                                <span class="badge
                                    rounded-pill
                                    @RentalStatusClass(rental.Status)">

                                    @RentalStatusText(rental.Status)

                                </span>

                                <span class="badge
                                    rounded-pill
                                    bg-light
                                    text-dark
                                    border">

                                    @PaymentStatusText(paymentStatus)

                                </span>

                            </div>

                        </div>

                        <div class="card-body p-4">

                            @if (details.Any())
                            {
                                <div class="row g-3">

                                    @foreach (var detail in details)
                                    {
                                        var imageUrl =
                                            string.IsNullOrWhiteSpace(
                                                detail.Book?.ImageUrl)
                                                ? "/images/books/default-book.jpg"
                                                : detail.Book.ImageUrl;

                                        <div class="col-12">

                                            <div class="d-flex
                                                align-items-center
                                                gap-3
                                                p-3
                                                bg-light
                                                rounded-3">

                                                <img src="@imageUrl"
                                                     alt="Ảnh sách"
                                                     style="width:65px;
                                                height:85px;
                                                object-fit:contain;
                                                background:white;
                                                border-radius:8px;"
                                                     onerror="this.onerror=null;
                                                this.src='/images/books/default-book.jpg';" />

                                                <div class="flex-grow-1">

                                                    <div class="fw-bold">

                                                        @(detail.Book?.Title
                                                            ?? "Sách không tồn tại")

                                                    </div>

                                                    <div class="small
                                                        text-muted">

                                                        @(detail.Book?.Author
                                                            ?? "Không rõ tác giả")

                                                    </div>

                                                    <div class="small
                                                        text-muted
                                                        mt-1">

                                                        @detail.Quantity cuốn
                                                        · @detail.RentalDays ngày

                                                    </div>

                                                </div>

                                                <strong class="text-danger">

                                                    @detail.SubTotal.ToString("N0")
                                                    VNĐ

                                                </strong>

                                            </div>

                                        </div>
                                    }

                                </div>
                            }
                            else
                            {
                                <div class="alert alert-light border">

                                    Đơn thuê chưa có dữ liệu sách.

                                </div>
                            }

                            <div class="row g-3 mt-2">

                                <div class="col-md-4">

                                    <div class="border
                                        rounded-3
                                        p-3">

                                        <small class="text-muted">
                                            Ngày thuê
                                        </small>

                                        <div class="fw-bold">

                                            @rental.RentalDate.ToString("dd/MM/yyyy")

                                        </div>

                                    </div>

                                </div>

                                <div class="col-md-4">

                                    <div class="border
                                        rounded-3
                                        p-3">

                                        <small class="text-muted">
                                            Ngày trả dự kiến
                                        </small>

                                        <div class="fw-bold">

                                            @rental.ReturnDate.ToString("dd/MM/yyyy")

                                        </div>

                                    </div>

                                </div>

                                <div class="col-md-4">

                                    <div class="border
                                        rounded-3
                                        p-3">

                                        <small class="text-muted">
                                            Thời hạn
                                        </small>

                                        <div class="fw-bold
                                            @(remainingDays < 0
                                                 ? "text-danger"
                                                 : remainingDays <= 2
                                                     ? "text-warning"
                                                     : "text-success")">

                                            @if (rental.Status != "Borrowing")
                                            {
                                                <span>
                                                    Chưa bắt đầu
                                                </span>
                                            }
                                            else if (remainingDays < 0)
                                            {
                                                <span>
                                                    Quá hạn
                                                    @Math.Abs(remainingDays)
                                                    ngày
                                                </span>
                                            }
                                            else if (remainingDays == 0)
                                            {
                                                <span>
                                                    Hạn trả hôm nay
                                                </span>
                                            }
                                            else
                                            {
                                                <span>
                                                    Còn @remainingDays ngày
                                                </span>
                                            }

                                        </div>

                                    </div>

                                </div>

                            </div>

                            <div class="d-flex
                                flex-wrap
                                justify-content-between
                                align-items-center
                                gap-3
                                mt-4
                                p-3
                                bg-light
                                rounded-3">

                                <div>

                                    <span class="text-muted">
                                        Tổng tiền:
                                    </span>

                                    <strong class="text-danger ms-2">

                                        @rental.TotalAmount.ToString("N0")
                                        VNĐ

                                    </strong>

                                </div>

                                <div class="d-flex
                                    flex-wrap
                                    gap-2">

                                    @if (CanPay(
                                        paymentStatus,
                                        rental.Status))
                                    {
                                        <a asp-controller="Rental"
                                           asp-action="Payment"
                                           asp-route-id="@rental.Id"
                                           class="btn btn-primary">

                                            <i class="bi bi-credit-card me-1">
                                            </i>

                                            Thanh toán

                                        </a>
                                    }

                                    <a asp-controller="Receipt"
                                       asp-action="Details"
                                       asp-route-id="@rental.Id"
                                       class="btn btn-outline-primary">

                                        <i class="bi bi-receipt me-1">
                                        </i>

                                        Chi tiết

                                    </a>

                                    @if (CanCancel(
                                        paymentStatus,
                                        rental.Status))
                                    {
                                        <form asp-controller="Rental"
                                              asp-action="Cancel"
                                              method="post"
                                              class="cancel-rental-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="rentalId"
                                                   value="@rental.Id" />

                                            <button type="submit"
                                                    class="btn
                                                btn-outline-danger">

                                                <i class="bi bi-x-circle me-1">
                                                </i>

                                                Hủy đơn

                                            </button>

                                        </form>
                                    }

                                </div>

                            </div>

                        </div>

                    </article>

                </div>
            }

        </div>
    }

</div>

@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                document.querySelectorAll(
                    ".cancel-rental-form"
                )
                .forEach(function (form) {

                    form.addEventListener(
                        "submit",
                        function (event) {

                            const confirmed =
                                window.confirm(
                                    "Bạn chắc chắn muốn hủy đơn thuê này?"
                                );

                            if (!confirmed) {
                                event.preventDefault();
                                return;
                            }

                            const button =
                                form.querySelector(
                                    "button[type='submit']"
                                );

                            if (button) {

                                button.disabled = true;

                                button.innerHTML =
                                    '<span class="spinner-border ' +
                                    'spinner-border-sm me-2">' +
                                    '</span>Đang hủy...';
                            }
                        }
                    );
                });
            }
        );

    </script>

}