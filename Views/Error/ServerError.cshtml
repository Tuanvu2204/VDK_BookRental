@{
    Layout = null;

    var requestPath =
        ViewBag.RequestPath as string
        ?? "/";
}

<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>
        Lỗi hệ thống - VDK Book Rental
    </title>

    <style>

            * {
                box-sizing: border-box;
            }

            body {
                min-height: 100vh;
                display: grid;
                place-items: center;
                padding: 24px;
                margin: 0;
                color: #172033;
                background: radial-gradient( circle at top right, rgba(37, 99, 235, .14), transparent 35% ), #f5f7fb;
                font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
            }

            .error-card {
                width: 100%;
                max-width: 610px;
                padding: 42px;
                background: #ffffff;
                border: 1px solid #e5e7eb;
                border-radius: 25px;
                box-shadow: 0 22px 55px rgba(15, 23, 42, .13);
                text-align: center;
            }

            .error-icon {
                width: 90px;
                height: 90px;
                display: inline-grid;
                place-items: center;
                margin-bottom: 20px;
                color: #dc2626;
                background: #fee2e2;
                border-radius: 28px;
                font-size: 42px;
            }

            h1 {
                margin: 0;
                font-size: 30px;
                font-weight: 900;
            }

            p {
                margin: 13px 0;
                color: #64748b;
                line-height: 1.7;
            }

            .path {
                padding: 12px;
                margin: 20px 0;
                overflow-wrap: anywhere;
                color: #475569;
                background: #f8fafc;
                border-radius: 12px;
                font-family: monospace;
                font-size: 13px;
            }

            .actions {
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
                gap: 10px;
                margin-top: 22px;
            }

            .button {
                min-height: 45px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 10px 19px;
                border-radius: 12px;
                font-weight: 800;
                text-decoration: none;
            }

            .button-primary {
                color: #ffffff;
                background: #2563eb;
            }

            .button-secondary {
                color: #334155;
                background: #f1f5f9;
            }

            @@media (max-width: 575px) {

                .error-card {
                    padding: 30px 20px;
                }

                .button {
                    width: 100%;
                }
            }

    </style>

</head>

<body>

    <main class="error-card">

        <div class="error-icon">
            ⚠
        </div>

        <h1>
            Hệ thống gặp sự cố
        </h1>

        <p>
            Yêu cầu chưa thể hoàn thành.
            Website vẫn đang hoạt động và chi tiết lỗi
            đã được ghi trong cửa sổ Output của Visual Studio.
        </p>

        <div class="path">
            @requestPath
        </div>

        <div class="actions">

            <a href="/Books"
               class="button button-primary">

                Về trang chủ

            </a>

            <a href="javascript:history.back()"
               class="button button-secondary">

                Quay lại

            </a>

        </div>

    </main>

</body>

</html>