@{
    Layout = null;

    var code =
        ViewBag.StatusCode is int statusCode
            ? statusCode
            : 500;

    var title =
        ViewBag.Title as string
        ?? "Không thể xử lý yêu cầu";

    var message =
        ViewBag.Message as string
        ?? "Đã xảy ra lỗi.";

    var originalPath =
        ViewBag.OriginalPath as string
        ?? "/";
}

<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>
        @code - VDK Book Rental
    </title>

    <style>

            * {
                box-sizing: border-box;
            }

            body {
                min-height: 100vh;
                display: grid;
                place-items: center;
                padding: 24px;
                margin: 0;
                color: #172033;
                background: #f5f7fb;
                font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
            }

            .status-card {
                width: 100%;
                max-width: 590px;
                padding: 42px;
                background: #ffffff;
                border-radius: 25px;
                box-shadow: 0 20px 50px rgba(15, 23, 42, .12);
                text-align: center;
            }

            .status-code {
                color: #2563eb;
                font-size: 76px;
                font-weight: 950;
                line-height: 1;
            }

            h1 {
                margin: 15px 0 10px;
                font-size: 28px;
            }

            p {
                color: #64748b;
                line-height: 1.7;
            }

            .path {
                padding: 12px;
                margin: 20px 0;
                overflow-wrap: anywhere;
                background: #f8fafc;
                border-radius: 12px;
                font-family: monospace;
                font-size: 13px;
            }

            .button {
                min-height: 45px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 10px 20px;
                color: #ffffff;
                background: #2563eb;
                border-radius: 12px;
                font-weight: 800;
                text-decoration: none;
            }

    </style>

</head>

<body>

    <main class="status-card">

        <div class="status-code">
            @code
        </div>

        <h1>
            @title
        </h1>

        <p>
            @message
        </p>

        <div class="path">
            @originalPath
        </div>

        <a href="/Books"
           class="button">

            Về trang chủ

        </a>

    </main>

</body>

</html>