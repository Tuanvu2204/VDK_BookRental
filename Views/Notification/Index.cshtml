@model VDK_BookRental.ViewModels.NotificationCenterViewModel

@{
    ViewData["Title"] = "Trung tâm thông báo";

    var totalNotifications =
        Model.PendingRentalCount
        + Model.AwaitingPaymentCount
        + Model.OverdueRentalCount
        + Model.LowStockBookCount;
}

<style>
    .notification-page {
        min-height: 100vh;
        padding: 32px 0 60px;
        background: radial-gradient( circle at top right, rgba(13, 110, 253, 0.1), transparent 31% ), #f5f7fb;
    }

    .notification-heading {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 24px;
    }

        .notification-heading h1 {
            margin: 0;
            color: #172033;
            font-size: clamp(1.8rem, 3vw, 2.45rem);
            font-weight: 900;
        }

        .notification-heading p {
            margin: 8px 0 0;
            color: #6c757d;
        }

    .notification-back-button {
        min-height: 46px;
        padding: 11px 18px;
        border-radius: 13px;
        font-weight: 800;
    }

    .notification-stat-card {
        height: 100%;
        padding: 20px;
        border: 1px solid rgba(20, 35, 60, 0.06);
        border-radius: 20px;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(24, 39, 75, 0.07);
    }

    .notification-stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
    }

    .notification-stat-label {
        color: #6c757d;
        font-size: 0.9rem;
        font-weight: 650;
    }

    .notification-stat-number {
        margin-top: 6px;
        color: #172033;
        font-size: 1.8rem;
        font-weight: 900;
    }

    .notification-stat-icon {
        width: 50px;
        height: 50px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        font-size: 1.35rem;
    }

    .notification-icon-warning {
        color: #997404;
        background: #fff3cd;
    }

    .notification-icon-info {
        color: #087990;
        background: #cff4fc;
    }

    .notification-icon-danger {
        color: #b02a37;
        background: #f8d7da;
    }

    .notification-icon-purple {
        color: #6f42c1;
        background: #eee7ff;
    }

    .notification-panel {
        height: 100%;
        overflow: hidden;
        border: none;
        border-radius: 22px;
        background: #ffffff;
        box-shadow: 0 12px 34px rgba(24, 39, 75, 0.08);
    }

    .notification-panel-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 20px 22px;
        border-bottom: 1px solid #edf0f4;
        background: #fbfcfe;
    }

        .notification-panel-header h2 {
            margin: 0;
            color: #172033;
            font-size: 1.2rem;
            font-weight: 900;
        }

    .notification-panel-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 32px;
        height: 32px;
        padding: 0 10px;
        border-radius: 999px;
        color: #ffffff;
        background: #0d6efd;
        font-size: 0.82rem;
        font-weight: 900;
    }

    .notification-list {
        display: grid;
    }

    .notification-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 17px 22px;
        border-bottom: 1px solid #edf0f4;
    }

        .notification-item:last-child {
            border-bottom: none;
        }

        .notification-item:hover {
            background: #fbfcff;
        }

    .notification-item-main {
        min-width: 0;
    }

    .notification-item-title {
        overflow: hidden;
        color: #172033;
        font-weight: 850;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .notification-item-meta {
        margin-top: 4px;
        color: #7a8494;
        font-size: 0.82rem;
    }

    .notification-item-value {
        color: #dc3545;
        font-weight: 900;
        white-space: nowrap;
    }

    .notification-action {
        min-height: 38px;
        padding: 7px 12px;
        border-radius: 10px;
        font-size: 0.82rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .notification-empty {
        padding: 55px 20px;
        color: #6c757d;
        text-align: center;
    }

        .notification-empty i {
            display: block;
            margin-bottom: 10px;
            color: #198754;
            font-size: 2rem;
        }

    .notification-all-clear {
        margin-top: 24px;
        padding: 38px 22px;
        border-radius: 22px;
        color: #146c43;
        background: #d1e7dd;
        box-shadow: 0 12px 34px rgba(25, 135, 84, 0.12);
        text-align: center;
    }

        .notification-all-clear i {
            display: block;
            margin-bottom: 10px;
            font-size: 2.2rem;
        }

        .notification-all-clear h2 {
            margin-bottom: 6px;
            font-weight: 900;
        }

    @@media (max-width: 767.98px) {
        .notification-page {
            padding-top: 22px;
        }

        .notification-heading {
            align-items: stretch;
        }

        .notification-back-button {
            width: 100%;
        }

        .notification-item {
            align-items: flex-start;
            flex-direction: column;
        }

        .notification-action {
            width: 100%;
        }
    }
</style>

<div class="notification-page">
    <div class="container-fluid px-3 px-lg-4">

        <div class="notification-heading">
            <div>
                <h1>
                    <i class="bi bi-bell-fill me-2 text-primary"></i>
                    Trung tâm thông báo
                </h1>

                <p>
                    Theo dõi các công việc cần nhân viên hoặc quản trị viên xử lý.
                </p>
            </div>

            <a asp-controller="Staff"
               asp-action="Index"
               class="btn btn-outline-primary notification-back-button">
                <i class="bi bi-arrow-left me-2"></i>
                Về trang quản lý
            </a>
        </div>

        <div class="row g-3">

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="notification-stat-card">
                    <div class="notification-stat-top">
                        <div>
                            <div class="notification-stat-label">
                                Đơn chờ duyệt
                            </div>

                            <div class="notification-stat-number">
                                @Model.PendingRentalCount
                            </div>
                        </div>

                        <div class="notification-stat-icon notification-icon-warning">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="notification-stat-card">
                    <div class="notification-stat-top">
                        <div>
                            <div class="notification-stat-label">
                                Thanh toán chờ xác nhận
                            </div>

                            <div class="notification-stat-number">
                                @Model.AwaitingPaymentCount
                            </div>
                        </div>

                        <div class="notification-stat-icon notification-icon-info">
                            <i class="bi bi-credit-card-2-front-fill"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="notification-stat-card">
                    <div class="notification-stat-top">
                        <div>
                            <div class="notification-stat-label">
                                Đơn quá hạn
                            </div>

                            <div class="notification-stat-number">
                                @Model.OverdueRentalCount
                            </div>
                        </div>

                        <div class="notification-stat-icon notification-icon-danger">
                            <i class="bi bi-calendar-x-fill"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="notification-stat-card">
                    <div class="notification-stat-top">
                        <div>
                            <div class="notification-stat-label">
                                Sách sắp hết
                            </div>

                            <div class="notification-stat-number">
                                @Model.LowStockBookCount
                            </div>
                        </div>

                        <div class="notification-stat-icon notification-icon-purple">
                            <i class="bi bi-exclamation-diamond-fill"></i>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        @if (totalNotifications == 0)
        {
            <div class="notification-all-clear">
                <i class="bi bi-shield-check"></i>

                <h2>Không có công việc tồn đọng</h2>

                <div>
                    Hệ thống hiện không có đơn chờ duyệt, thanh toán chờ xác nhận,
                    đơn quá hạn hoặc sách sắp hết.
                </div>
            </div>
        }

        <div class="row g-4 mt-1">

            <div class="col-12 col-xl-6">
                <div class="notification-panel">

                    <div class="notification-panel-header">
                        <h2>
                            <i class="bi bi-receipt me-2 text-warning"></i>
                            Đơn thuê chờ duyệt
                        </h2>

                        <span class="notification-panel-count">
                            @Model.PendingRentalCount
                        </span>
                    </div>

                    @if (Model.PendingRentals.Any())
                    {
                        <div class="notification-list">
                            @foreach (var rental in Model.PendingRentals)
                            {
                                <div class="notification-item">
                                    <div class="notification-item-main">
                                        <div class="notification-item-title">
                                            #RENT-@rental.RentalId.ToString("D4")
                                            · @rental.CustomerName
                                        </div>

                                        <div class="notification-item-meta">
                                            Ngày thuê:
                                            @rental.RentalDate.ToString("dd/MM/yyyy")
                                            · @rental.TotalAmount.ToString("N0") VNĐ
                                        </div>
                                    </div>

                                    <a asp-controller="Staff"
                                       asp-action="RentalDetails"
                                       asp-route-id="@rental.RentalId"
                                       class="btn btn-outline-warning notification-action">
                                        Xử lý
                                    </a>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="notification-empty">
                            <i class="bi bi-check-circle-fill"></i>
                            Không có đơn thuê đang chờ duyệt.
                        </div>
                    }

                </div>
            </div>

            <div class="col-12 col-xl-6">
                <div class="notification-panel">

                    <div class="notification-panel-header">
                        <h2>
                            <i class="bi bi-credit-card me-2 text-info"></i>
                            Thanh toán chờ xác nhận
                        </h2>

                        <span class="notification-panel-count">
                            @Model.AwaitingPaymentCount
                        </span>
                    </div>

                    @if (Model.AwaitingPayments.Any())
                    {
                        <div class="notification-list">
                            @foreach (var payment in Model.AwaitingPayments)
                            {
                                <div class="notification-item">
                                    <div class="notification-item-main">
                                        <div class="notification-item-title">
                                            #PAY-@payment.PaymentId.ToString("D4")
                                            · @payment.CustomerName
                                        </div>

                                        <div class="notification-item-meta">
                                            @payment.PaymentMethod
                                            · @payment.Amount.ToString("N0") VNĐ
                                        </div>
                                    </div>

                                    <a asp-controller="Staff"
                                       asp-action="Payments"
                                       asp-route-status="AwaitingConfirmation"
                                       class="btn btn-outline-info notification-action">
                                        Kiểm tra
                                    </a>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="notification-empty">
                            <i class="bi bi-check-circle-fill"></i>
                            Không có thanh toán đang chờ xác nhận.
                        </div>
                    }

                </div>
            </div>

            <div class="col-12 col-xl-6">
                <div class="notification-panel">

                    <div class="notification-panel-header">
                        <h2>
                            <i class="bi bi-calendar-x me-2 text-danger"></i>
                            Đơn thuê quá hạn
                        </h2>

                        <span class="notification-panel-count">
                            @Model.OverdueRentalCount
                        </span>
                    </div>

                    @if (Model.OverdueRentals.Any())
                    {
                        <div class="notification-list">
                            @foreach (var rental in Model.OverdueRentals)
                            {
                                <div class="notification-item">
                                    <div class="notification-item-main">
                                        <div class="notification-item-title">
                                            #RENT-@rental.RentalId.ToString("D4")
                                            · @rental.CustomerName
                                        </div>

                                        <div class="notification-item-meta">
                                            Hạn trả:
                                            @rental.ReturnDate.ToString("dd/MM/yyyy")
                                            · Quá @rental.OverdueDays ngày
                                        </div>
                                    </div>

                                    <a asp-controller="Overdue"
                                       asp-action="Index"
                                       class="btn btn-outline-danger notification-action">
                                        Xử lý
                                    </a>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="notification-empty">
                            <i class="bi bi-check-circle-fill"></i>
                            Không có đơn thuê quá hạn.
                        </div>
                    }

                </div>
            </div>

            <div class="col-12 col-xl-6">
                <div class="notification-panel">

                    <div class="notification-panel-header">
                        <h2>
                            <i class="bi bi-bookshelf me-2 text-primary"></i>
                            Sách sắp hết trong kho
                        </h2>

                        <span class="notification-panel-count">
                            @Model.LowStockBookCount
                        </span>
                    </div>

                    @if (Model.LowStockBooks.Any())
                    {
                        <div class="notification-list">
                            @foreach (var book in Model.LowStockBooks)
                            {
                                <div class="notification-item">
                                    <div class="notification-item-main">
                                        <div class="notification-item-title">
                                            @book.Title
                                        </div>

                                        <div class="notification-item-meta">
                                            Mã sách:
                                            #BOOK-@book.BookId.ToString("D3")
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center gap-2">
                                        <span class="notification-item-value">
                                            Còn @book.Quantity
                                        </span>

                                        <a asp-controller="Staff"
                                           asp-action="Books"
                                           class="btn btn-outline-primary notification-action">
                                            Xem kho
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="notification-empty">
                            <i class="bi bi-check-circle-fill"></i>
                            Số lượng sách trong kho đang ổn định.
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</div>
