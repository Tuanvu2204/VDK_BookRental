@inherits Microsoft.AspNetCore.Mvc.Razor.RazorPage<dynamic>
@* Simple pagination partial expecting: ViewData["PageNumber"], ViewData["TotalPages"], route values available in ViewContext.RouteData.Values *@
@{
	var pageNumber = ViewData["PageNumber"] as int? ?? 1;
	var totalPages = ViewData["TotalPages"] as int? ?? 1;
}
<nav aria-label="Page navigation">
	<ul class="pagination">
		<li class="page-item @(pageNumber<=1?"disabled":"")">
			<a class="page-link" href="?page=@(pageNumber-1)">Prev</a>
		</li>
		@for(var p=1;p<=totalPages;p++){
			<li class="page-item @(p==pageNumber?"active":"")"><a class="page-link" href="?page=@p">@p</a></li>
		}
		<li class="page-item @(pageNumber>=totalPages?"disabled":"")">
			<a class="page-link" href="?page=@(pageNumber+1)">Next</a>
		</li>
	</ul>
</nav>
