@using Microsoft.AspNetCore.Http
@using System

@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString()
        ?? string.Empty;

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString()
        ?? string.Empty;

    var userId =
        Context.Session.GetString("UserId");

    var fullName =
        Context.Session.GetString("FullName");

    var userName =
        Context.Session.GetString("UserName");

    var userRole =
        Context.Session.GetString("UserRole");

    var avatarUrl =
        Context.Session.GetString("AvatarUrl");

    var isLoggedIn =
        !string.IsNullOrWhiteSpace(userId);

    var isAdmin =
        string.Equals(
            userRole,
            "Admin",
            StringComparison.OrdinalIgnoreCase);

    var isStaff =
        string.Equals(
            userRole,
            "Staff",
            StringComparison.OrdinalIgnoreCase);

    var isCustomer =
        string.Equals(
            userRole,
            "Customer",
            StringComparison.OrdinalIgnoreCase);

    var displayName =
        !string.IsNullOrWhiteSpace(fullName)
            ? fullName.Trim()
            : !string.IsNullOrWhiteSpace(userName)
                ? userName.Trim()
                : "Người dùng";

    var roleName =
        isAdmin
            ? "Quản trị viên"
            : isStaff
                ? "Nhân viên"
                : "Khách hàng";

    var roleClass =
        isAdmin
            ? "layout-role-admin"
            : isStaff
                ? "layout-role-staff"
                : "layout-role-customer";

    var profileText =
        isCustomer
            ? "Hồ sơ khách hàng"
            : "Hồ sơ cá nhân";

    var firstLetter =
        !string.IsNullOrWhiteSpace(displayName)
            ? displayName.Substring(0, 1).ToUpperInvariant()
            : "U";

    var bodyClass =
        ViewData["BodyClass"]?.ToString()
        ?? string.Empty;

    string ActiveMenu(
        string controller,
        string action = "")
    {
        var controllerMatched =
            string.Equals(
                currentController,
                controller,
                StringComparison.OrdinalIgnoreCase);

        if (!controllerMatched)
        {
            return string.Empty;
        }

        if (string.IsNullOrWhiteSpace(action))
        {
            return "active";
        }

        return string.Equals(
            currentAction,
            action,
            StringComparison.OrdinalIgnoreCase)
                ? "active"
                : string.Empty;
    }
}

<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="description"
          content="VDK Book Rental - Hệ thống quản lý và cho thuê sách trực tuyến." />

    <meta name="theme-color"
          content="#2563eb" />

    <title>
        @(ViewData["Title"] ?? "Trang chủ") - VDK Book Rental
    </title>

    <link rel="icon"
          type="image/x-icon"
          href="~/favicon.ico" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/vdk-layout.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/book-loading.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/VDK_BookRental.styles.css"
          asp-append-version="true" />

    @await RenderSectionAsync(
        "Styles",
        required: false)

</head>

<body class="@bodyClass">

    <a class="layout-skip-link"
       href="#mainContent">

        Chuyển đến nội dung chính

    </a>

    <div id="pageProgress"
         class="layout-page-progress">
    </div>

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="layout-header">

        <nav id="mainNavbar"
             class="navbar navbar-expand-lg layout-navbar">

            <div class="container">

                <a class="navbar-brand layout-brand"
                   asp-controller="Books"
                   asp-action="Index">

                    <span class="layout-brand-icon">
                        <i class="bi bi-book-half"></i>
                    </span>

                    <span class="layout-brand-text">

                        VDK Book Rental

                        <small>
                            Hệ thống thuê sách
                        </small>

                    </span>

                </a>

                <button class="navbar-toggler layout-navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbarContent"
                        aria-controls="mainNavbarContent"
                        aria-expanded="false"
                        aria-label="Mở hoặc đóng menu">

                    <span class="navbar-toggler-icon">
                    </span>

                </button>

                <div id="mainNavbarContent"
                     class="collapse navbar-collapse">

                    <ul class="navbar-nav layout-main-menu ms-lg-4 me-auto mb-2 mb-lg-0">

                        <li class="nav-item">

                            <a id="homeNavLink"
                               class="nav-link @ActiveMenu("Books", "Index")"
                               asp-controller="Books"
                               asp-action="Index">

                                <i class="bi bi-house-door"></i>
                                Trang chủ

                            </a>

                        </li>

                        <li class="nav-item">

                            <a id="rentalGuideNavLink"
                               class="nav-link"
                               asp-controller="Books"
                               asp-action="Index"
                               asp-fragment="rentalGuide">

                                <i class="bi bi-signpost-split"></i>
                                Cách thuê

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link @ActiveMenu("Books", "Featured")"
                               asp-controller="Books"
                               asp-action="Featured">

                                <i class="bi bi-fire"></i>
                                Sách nổi bật

                            </a>

                        </li>

                        @if (isLoggedIn)
                        {
                            <li class="nav-item">

                                <a class="nav-link @ActiveMenu("Rental", "Current")"
                                   asp-controller="Rental"
                                   asp-action="Current">

                                    <i class="bi bi-book-half"></i>
                                    Đang thuê

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link @ActiveMenu("Rental", "History")"
                                   asp-controller="Rental"
                                   asp-action="History">

                                    <i class="bi bi-clock-history"></i>
                                    Lịch sử

                                </a>

                            </li>
                        }

                        <li class="nav-item">

                            <a class="nav-link"
                               href="#footerContact">

                                <i class="bi bi-telephone"></i>
                                Liên hệ

                            </a>

                        </li>

                        @if (isAdmin)
                        {
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle layout-admin-link @ActiveMenu("Admin")"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    <i class="bi bi-shield-lock"></i>
                                    Quản trị

                                </a>

                                <ul class="dropdown-menu layout-dropdown">

                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="Admin"
                                           asp-action="Index">

                                            <i class="bi bi-speedometer2"></i>
                                            Dashboard quản trị

                                        </a>

                                    </li>

                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="Admin"
                                           asp-action="Books">

                                            <i class="bi bi-book"></i>
                                            Quản lý sách

                                        </a>

                                    </li>

                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="Admin"
                                           asp-action="Users">

                                            <i class="bi bi-people"></i>
                                            Quản lý người dùng

                                        </a>

                                    </li>

                                </ul>

                            </li>
                        }

                        @if (isStaff)
                        {
                            <li class="nav-item">

                                <a class="nav-link layout-staff-link @ActiveMenu("Staff")"
                                   asp-controller="Staff"
                                   asp-action="Index">

                                    <i class="bi bi-person-workspace"></i>
                                    Nhân viên

                                </a>

                            </li>
                        }

                    </ul>

                    <!-- TÀI KHOẢN -->
                    <div class="layout-account-area">

                        @if (isLoggedIn)
                        {
                            <div class="dropdown">

                                <button class="layout-user-button dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">

                                    <span class="layout-user-avatar">

                                        @if (!string.IsNullOrWhiteSpace(avatarUrl))
                                        {
                                            <img src="@avatarUrl"
                                                 alt="Ảnh đại diện của @displayName"
                                                 class="layout-avatar-image"
                                                 onerror="this.classList.add('d-none');this.nextElementSibling.classList.remove('d-none');" />

                                            <span class="layout-avatar-fallback d-none">
                                                @firstLetter
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="layout-avatar-fallback">
                                                @firstLetter
                                            </span>
                                        }

                                    </span>

                                    <span class="layout-user-info">

                                        <span class="layout-user-name">
                                            @displayName
                                        </span>

                                        <span class="layout-user-role">
                                            @roleName
                                        </span>

                                    </span>

                                </button>

                                <ul class="dropdown-menu dropdown-menu-end layout-dropdown layout-account-dropdown">

                                    <li class="layout-account-header">

                                        <div class="layout-account-name">
                                            @displayName
                                        </div>

                                        <div class="layout-account-username">
                                            @("@" + (userName ?? "Chưa cập nhật"))
                                        </div>

                                        <span class="layout-role-badge @roleClass">

                                            <i class="bi bi-shield-check"></i>
                                            @roleName

                                        </span>

                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>

                                        <a class="dropdown-item @ActiveMenu("Profile", "Index")"
                                           asp-controller="Profile"
                                           asp-action="Index">

                                            <i class="bi bi-person-circle"></i>
                                            @profileText

                                        </a>

                                    </li>

                                    @if (isAdmin)
                                    {
                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Admin"
                                               asp-action="Index">

                                                <i class="bi bi-speedometer2"></i>
                                                Trang quản trị

                                            </a>

                                        </li>

                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Admin"
                                               asp-action="Books">

                                                <i class="bi bi-book"></i>
                                                Quản lý sách

                                            </a>

                                        </li>

                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Admin"
                                               asp-action="Users">

                                                <i class="bi bi-people"></i>
                                                Quản lý người dùng

                                            </a>

                                        </li>
                                    }

                                    @if (isStaff)
                                    {
                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Staff"
                                               asp-action="Index">

                                                <i class="bi bi-person-workspace"></i>
                                                Trang nhân viên

                                            </a>

                                        </li>
                                    }

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="Rental"
                                           asp-action="Current">

                                            <i class="bi bi-book-half"></i>
                                            Sách đang thuê

                                        </a>

                                    </li>

                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="Rental"
                                           asp-action="History">

                                            <i class="bi bi-clock-history"></i>
                                            Lịch sử thuê

                                        </a>

                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>

                                        <a class="dropdown-item text-danger"
                                           asp-controller="Account"
                                           asp-action="Logout">

                                            <i class="bi bi-box-arrow-right"></i>
                                            Đăng xuất

                                        </a>

                                    </li>

                                </ul>

                            </div>
                        }
                        else
                        {
                            <div class="layout-auth-actions">

                                <a class="layout-login-link"
                                   asp-controller="Account"
                                   asp-action="Login">

                                    <i class="bi bi-box-arrow-in-right"></i>
                                    Đăng nhập

                                </a>

                                <a class="layout-register-button"
                                   asp-controller="Account"
                                   asp-action="Register">

                                    <i class="bi bi-person-plus"></i>
                                    Tạo tài khoản

                                </a>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </nav>

    </header>

    <!-- =====================================================
         MAIN
    ====================================================== -->

    <main id="mainContent"
          role="main"
          class="layout-main-content">

        @RenderBody()

    </main>

    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <footer id="footerContact"
            class="layout-footer">

        <div class="layout-footer-top">

            <div class="container">

                <div class="row gy-4">

                    <div class="col-lg-5 col-md-6">

                        <div class="layout-footer-brand">

                            <span class="layout-brand-icon">
                                <i class="bi bi-book-half"></i>
                            </span>

                            VDK Book Rental

                        </div>

                        <p class="layout-footer-description">

                            Hệ thống quản lý và cho thuê sách trực tuyến,
                            giúp tìm kiếm, đăng ký thuê, thanh toán và
                            theo dõi đơn thuê nhanh chóng, thuận tiện.

                        </p>

                    </div>

                    <div class="col-lg-3 col-md-6">

                        <h5 class="layout-footer-title">
                            Liên kết nhanh
                        </h5>

                        <ul class="layout-footer-links">

                            <li>

                                <a asp-controller="Books"
                                   asp-action="Index">

                                    <i class="bi bi-bookshelf"></i>
                                    Kho sách

                                </a>

                            </li>

                            <li>

                                <a asp-controller="Books"
                                   asp-action="Index"
                                   asp-fragment="rentalGuide">

                                    <i class="bi bi-signpost-split"></i>
                                    Cách thuê sách

                                </a>

                            </li>

                            <li>

                                <a asp-controller="Books"
                                   asp-action="Featured">

                                    <i class="bi bi-fire"></i>
                                    Sách nổi bật

                                </a>

                            </li>

                            @if (isLoggedIn)
                            {
                                <li>

                                    <a asp-controller="Profile"
                                       asp-action="Index">

                                        <i class="bi bi-person-circle"></i>
                                        @profileText

                                    </a>

                                </li>
                            }

                        </ul>

                    </div>

                    <div class="col-lg-4 col-md-12">

                        <h5 class="layout-footer-title">
                            Thông tin liên hệ
                        </h5>

                        <div class="layout-contact-item">

                            <span class="layout-contact-icon">
                                <i class="bi bi-envelope-fill"></i>
                            </span>

                            <div>

                                <span class="layout-contact-label">
                                    Email hỗ trợ
                                </span>

                                <a href="mailto:nguyenhuynhtuanvu2309@gmail.com">
                                    nguyenhuynhtuanvu2309@gmail.com
                                </a>

                            </div>

                        </div>

                        <div class="layout-contact-item">

                            <span class="layout-contact-icon">
                                <i class="bi bi-telephone-fill"></i>
                            </span>

                            <div>

                                <span class="layout-contact-label">
                                    Điện thoại
                                </span>

                                <a href="tel:0817857316">
                                    0817 857 316
                                </a>

                            </div>

                        </div>

                        <div class="layout-contact-item">

                            <span class="layout-contact-icon">
                                <i class="bi bi-geo-alt-fill"></i>
                            </span>

                            <div>

                                <span class="layout-contact-label">
                                    Địa chỉ
                                </span>

                                <span>
                                    Thành phố Hồ Chí Minh, Việt Nam
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="layout-footer-bottom">

            <div class="container">

                <div class="row align-items-center">

                    <div class="col-md-6">

                        <p>
                            © @DateTime.Now.Year
                            <strong>VDK Book Rental</strong>.
                            All rights reserved.
                        </p>

                    </div>

                    <div class="col-md-6 text-md-end">

                        <p>
                            Phát triển bởi
                            <strong>Nhóm VDK</strong>
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </footer>

    <button id="scrollTopButton"
            class="layout-scroll-top"
            type="button"
            aria-label="Cuộn lên đầu trang">

        <i class="bi bi-arrow-up"></i>

    </button>

    <partial name="_BookLoading" />

    <script src="~/lib/jquery/dist/jquery.min.js">
    </script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    <script src="~/js/book-loading.js"
            asp-append-version="true">
    </script>

    <script src="~/js/vdk-layout.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>