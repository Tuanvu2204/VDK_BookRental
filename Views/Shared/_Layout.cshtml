    @*
        Chatbot AI dùng API POST /api/chat.
        File Views/Shared/_AIChatBox.cshtml phải tồn tại.
    *@
    <partial name="_AIChatBox" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <script src="~/js/ai-chat.js"
            asp-append-version="true"></script>


    <script id="vdk-messagebox-script">
        (() => {
            "use strict";

            const iconTitles = {
                success: "Thành công",
                error: "Không thể thực hiện",
                warning: "Cần lưu ý",
                info: "Thông báo",
                question: "Xác nhận"
            };

            const allowedIcons = new Set([
                "success",
                "error",
                "warning",
                "info",
                "question"
            ]);

            function normalizeIcon(icon) {
                return allowedIcons.has(icon)
                    ? icon
                    : "info";
            }

            function normalizeText(value) {
                if (value === null ||
                    value === undefined) {
                    return "";
                }

                return String(value).trim();
            }

            function hasSweetAlert() {
                return typeof window.Swal === "function";
            }

            function customClass(isToast) {
                return {
                    popup: isToast
                        ? "vdk-swal-popup vdk-swal-toast-popup"
                        : "vdk-swal-popup",

                    title: "vdk-swal-title",
                    htmlContainer: "vdk-swal-content",
                    confirmButton: "vdk-swal-confirm",
                    cancelButton: "vdk-swal-cancel",
                    timerProgressBar: "vdk-swal-progress"
                };
            }

            async function show(options = {}) {
                const icon =
                    normalizeIcon(
                        options.icon ?? "info"
                    );

                const title =
                    normalizeText(options.title) ||
                    iconTitles[icon];

                const message =
                    normalizeText(
                        options.message ??
                        options.text
                    );

                if (!message) {
                    return {
                        isConfirmed: false,
                        isDismissed: true
                    };
                }

                if (!hasSweetAlert()) {
                    console.error(
                        "SweetAlert2 chưa được tải."
                    );

                    return {
                        isConfirmed: false,
                        isDismissed: true
                    };
                }

                const isToast =
                    options.toast === true;

                const swalOptions = {
                    icon,
                    title,
                    text: message,

                    toast: isToast,

                    position: isToast
                        ? "top-end"
                        : "center",

                    width: isToast
                        ? undefined
                        : 470,

                    showConfirmButton:
                        options.showConfirmButton ??
                        !isToast,

                    showCancelButton:
                        !isToast &&
                        options.showCancelButton === true,

                    confirmButtonText:
                        options.confirmButtonText ??
                        "Đã hiểu",

                    cancelButtonText:
                        options.cancelButtonText ??
                        "Đóng",

                    buttonsStyling: false,

                    timer:
                        options.timer ??
                        (isToast ? 4300 : undefined),

                    timerProgressBar:
                        options.timerProgressBar ??
                        isToast,

                    showCloseButton:
                        options.showCloseButton ??
                        !isToast,

                    reverseButtons:
                        !isToast,

                    customClass:
                        customClass(isToast),

                    didOpen: popup => {
                        if (!isToast) {
                            return;
                        }

                        popup.addEventListener(
                            "mouseenter",
                            window.Swal.stopTimer
                        );

                        popup.addEventListener(
                            "mouseleave",
                            window.Swal.resumeTimer
                        );
                    }
                };

                /*
                 * Các thiết lập này chỉ dùng cho hộp thoại
                 * ở giữa màn hình, không truyền vào Toast.
                 */
                if (!isToast) {
                    swalOptions.allowOutsideClick =
                        options.allowOutsideClick ??
                        false;

                    swalOptions.allowEscapeKey =
                        options.allowEscapeKey ??
                        true;

                    swalOptions.focusConfirm =
                        true;
                }

                return await window.Swal.fire(
                    swalOptions
                );
            }

            async function success(
                message,
                title = "Thành công"
            ) {
                return await show({
                    icon: "success",
                    title,
                    message,
                    toast: true
                });
            }

            async function error(
                message,
                title = "Không thể thực hiện"
            ) {
                return await show({
                    icon: "error",
                    title,
                    message,
                    toast: false
                });
            }

            async function warning(
                message,
                title = "Cần lưu ý"
            ) {
                return await show({
                    icon: "warning",
                    title,
                    message,
                    toast: false
                });
            }

            async function info(
                message,
                title = "Thông báo"
            ) {
                return await show({
                    icon: "info",
                    title,
                    message,
                    toast: true
                });
            }

            async function confirmAction(
                options = {}
            ) {
                const result =
                    await show({
                        icon:
                            normalizeIcon(
                                options.icon ??
                                "question"
                            ),

                        title:
                            normalizeText(
                                options.title
                            ) ||
                            "Xác nhận thao tác",

                        message:
                            normalizeText(
                                options.message ??
                                options.text
                            ),

                        toast: false,
                        showConfirmButton: true,
                        showCancelButton: true,

                        confirmButtonText:
                            options.confirmButtonText ??
                            "Xác nhận",

                        cancelButtonText:
                            options.cancelButtonText ??
                            "Hủy",

                        allowOutsideClick: false
                    });

                return result.isConfirmed === true;
            }

            window.VDKMessage = Object.freeze({
                show,
                success,
                error,
                warning,
                info,
                confirm: confirmAction
            });

            /*
             * Ghi đè alert mặc định để không còn
             * hộp thoại "localhost says".
             */
            window.alert = message => {
                void window.VDKMessage.info(
                    normalizeText(message)
                );
            };

            async function showServerNotifications() {
                const payloadElement =
                    document.getElementById(
                        "vdk-server-notifications"
                    );

                if (!payloadElement) {
                    return;
                }

                let notifications = [];

                try {
                    notifications =
                        JSON.parse(
                            payloadElement.textContent ||
                            "[]"
                        );
                }
                catch (parseError) {
                    console.error(
                        "Không đọc được dữ liệu MessageBox.",
                        parseError
                    );

                    return;
                }

                if (!Array.isArray(notifications)) {
                    return;
                }

                for (const notification of notifications) {
                    const icon =
                        normalizeIcon(
                            notification?.icon
                        );

                    const message =
                        normalizeText(
                            notification?.message
                        );

                    if (!message) {
                        continue;
                    }

                    await show({
                        icon,

                        title:
                            normalizeText(
                                notification?.title
                            ) ||
                            iconTitles[icon],

                        message,

                        toast:
                            icon === "success" ||
                            icon === "info"
                    });
                }
            }

            if (document.readyState === "loading") {
                document.addEventListener(
                    "DOMContentLoaded",
                    () => {
                        void showServerNotifications();
                    },
                    {
                        once: true
                    }
                );
            }
            else {
                void showServerNotifications();
            }

            console.info(
                "VDK Modern MessageBox đã khởi tạo."
            );
        })();
    </script>

@await RenderSectionAsync(
        "Scripts",
        required: false)
</body>
