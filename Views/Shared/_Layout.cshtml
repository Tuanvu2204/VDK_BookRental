@using Microsoft.AspNetCore.Http
@using System.Text.Json

@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?
            .ToString() ?? string.Empty;

    var currentAction =
        ViewContext.RouteData.Values["action"]?
            .ToString() ?? string.Empty;

    var userId =
        Context.Session.GetString("UserId");

    var userName =
        Context.Session.GetString("UserName");

    var fullName =
        Context.Session.GetString("FullName");

    var userRole =
        Context.Session.GetString("UserRole");

    var avatarUrl =
        Context.Session.GetString("AvatarUrl");

    var isLoggedIn =
        !string.IsNullOrWhiteSpace(userId);

    var displayName =
        !string.IsNullOrWhiteSpace(fullName)
            ? fullName
            : !string.IsNullOrWhiteSpace(userName)
                ? userName
                : "Người dùng";

    var isAdmin =
        string.Equals(
            userRole,
            "Admin",
            StringComparison.OrdinalIgnoreCase);

    var isStaff =
        string.Equals(
            userRole,
            "Staff",
            StringComparison.OrdinalIgnoreCase);

    var initials = "U";

    if (!string.IsNullOrWhiteSpace(displayName))
    {
        var nameParts =
            displayName.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);

        initials =
            string.Concat(
                nameParts
                    .Take(2)
                    .Select(
                        part =>
                            char.ToUpperInvariant(part[0])));
    }

    string ActiveClass(
        string controller,
        string? action = null)
    {
        var controllerMatched =
            string.Equals(
                currentController,
                controller,
                StringComparison.OrdinalIgnoreCase);

        var actionMatched =
            string.IsNullOrWhiteSpace(action) ||
            string.Equals(
                currentAction,
                action,
                StringComparison.OrdinalIgnoreCase);

        return controllerMatched && actionMatched
            ? "active"
            : string.Empty;
    }


    var successMessage =
        (TempData["SuccessMessage"] ??
         TempData["Success"])?.ToString();

    var errorMessage =
        (TempData["ErrorMessage"] ??
         TempData["Error"])?.ToString();

    var warningMessage =
        (TempData["WarningMessage"] ??
         TempData["Warning"])?.ToString();

    var infoMessage =
        (TempData["InfoMessage"] ??
         TempData["Info"])?.ToString();

    var messageBoxNotifications =
        new System.Collections.Generic.List<object>();

    if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        messageBoxNotifications.Add(
            new
            {
                icon = "error",
                title = "Không thể thực hiện",
                message = errorMessage
            }
        );
    }

    if (!string.IsNullOrWhiteSpace(warningMessage))
    {
        messageBoxNotifications.Add(
            new
            {
                icon = "warning",
                title = "Cần lưu ý",
                message = warningMessage
            }
        );
    }

    if (!string.IsNullOrWhiteSpace(successMessage))
    {
        messageBoxNotifications.Add(
            new
            {
                icon = "success",
                title = "Thành công",
                message = successMessage
            }
        );
    }

    if (!string.IsNullOrWhiteSpace(infoMessage))
    {
        messageBoxNotifications.Add(
            new
            {
                icon = "info",
                title = "Thông báo",
                message = infoMessage
            }
        );
    }

    var messageBoxNotificationJson =
        JsonSerializer.Serialize(
            messageBoxNotifications
        );
}

<!DOCTYPE html>

<html lang="vi">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="description"
          content="VDK Book Rental - Hệ thống thuê sách trực tuyến" />

    <title>
        @ViewData["Title"] - VDK Book Rental
    </title>

    <link rel="icon"
          type="image/x-icon"
          href="~/favicon.ico" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/VDK_BookRental.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/ai-chat.css"
          asp-append-version="true" />

    @await RenderSectionAsync(
        "Styles",
        required: false)

    <style>
        :root {
            --vdk-primary: #2563eb;
            --vdk-primary-dark: #1d4ed8;
            --vdk-secondary: #7c3aed;
            --vdk-text: #0f172a;
            --vdk-muted: #64748b;
            --vdk-border: #e2e8f0;
            --vdk-background: #f4f7fb;
            --vdk-card: #ffffff;
            --vdk-footer: #0f1f3d;
        }

        html {
            position: relative;
            min-height: 100%;
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            margin: 0;
            background: var(--vdk-background);
            color: var(--vdk-text);
            font-family:
                Inter,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;
            display: flex;
            flex-direction: column;
        }

        a {
            text-decoration: none;
        }

        .vdk-navbar {
            position: sticky;
            top: 0;
            z-index: 1030;
            min-height: 72px;
            background: rgba(255, 255, 255, 0.96);
            border-bottom: 1px solid rgba(226, 232, 240, 0.9);
            box-shadow: 0 5px 22px rgba(15, 23, 42, 0.05);
            backdrop-filter: blur(14px);
        }

        .vdk-navbar .navbar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--vdk-text);
            font-size: 17px;
            font-weight: 800;
            letter-spacing: -0.02em;
        }

        .vdk-logo {
            width: 39px;
            height: 39px;
            border-radius: 13px;
            background:
                linear-gradient(
                    135deg,
                    var(--vdk-primary),
                    var(--vdk-secondary)
                );
            color: #ffffff;
            display: grid;
            place-items: center;
            box-shadow: 0 8px 22px rgba(37, 99, 235, 0.25);
        }

        .vdk-logo i {
            font-size: 19px;
        }

        .vdk-brand-text {
            display: flex;
            flex-direction: column;
            line-height: 1.1;
        }

        .vdk-brand-text small {
            margin-top: 4px;
            color: var(--vdk-muted);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0;
        }

        .vdk-navbar .nav-link {
            position: relative;
            margin: 0 3px;
            padding: 10px 12px !important;
            border-radius: 10px;
            color: #475569;
            font-size: 14px;
            font-weight: 650;
            transition:
                background 0.2s ease,
                color 0.2s ease,
                transform 0.2s ease;
        }

        .vdk-navbar .nav-link:hover {
            background: #eff6ff;
            color: var(--vdk-primary);
            transform: translateY(-1px);
        }

        .vdk-navbar .nav-link.active {
            background: #eaf2ff;
            color: var(--vdk-primary);
        }

        .vdk-navbar .nav-link i {
            margin-right: 5px;
        }

        .vdk-user-dropdown {
            padding: 6px 8px !important;
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .vdk-user-avatar {
            width: 36px;
            height: 36px;
            flex: 0 0 36px;
            overflow: hidden;
            border-radius: 12px;
            background:
                linear-gradient(
                    135deg,
                    var(--vdk-primary),
                    var(--vdk-secondary)
                );
            color: #ffffff;
            display: grid;
            place-items: center;
            font-size: 12px;
            font-weight: 800;
            box-shadow: 0 5px 15px rgba(37, 99, 235, 0.2);
        }

        .vdk-user-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .vdk-user-info {
            max-width: 145px;
            display: flex;
            flex-direction: column;
            line-height: 1.15;
        }

        .vdk-user-info strong {
            overflow: hidden;
            color: #1e293b;
            font-size: 13px;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .vdk-user-info small {
            margin-top: 3px;
            color: var(--vdk-muted);
            font-size: 10px;
        }

        .vdk-dropdown-menu {
            min-width: 230px;
            margin-top: 10px !important;
            padding: 8px;
            border: 1px solid var(--vdk-border);
            border-radius: 16px;
            box-shadow: 0 18px 48px rgba(15, 23, 42, 0.14);
        }

        .vdk-dropdown-menu .dropdown-item {
            padding: 10px 12px;
            border-radius: 10px;
            color: #334155;
            font-size: 14px;
            font-weight: 550;
        }

        .vdk-dropdown-menu .dropdown-item:hover {
            background: #eff6ff;
            color: var(--vdk-primary);
        }

        .vdk-dropdown-menu .dropdown-item i {
            width: 20px;
            margin-right: 6px;
        }

        .vdk-auth-button {
            min-height: 40px;
            padding: 9px 15px;
            border-radius: 11px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 700;
        }

        .vdk-login-button {
            border: 1px solid #cbd5e1;
            background: #ffffff;
            color: #334155;
        }

        .vdk-login-button:hover {
            border-color: #93c5fd;
            background: #eff6ff;
            color: var(--vdk-primary);
        }

        .vdk-register-button {
            border: 1px solid transparent;
            background:
                linear-gradient(
                    135deg,
                    var(--vdk-primary),
                    var(--vdk-secondary)
                );
            color: #ffffff;
            box-shadow: 0 7px 18px rgba(37, 99, 235, 0.2);
        }

        .vdk-register-button:hover {
            color: #ffffff;
            transform: translateY(-1px);
        }

        .vdk-page-content {
            width: 100%;
            flex: 1;
        }

        .vdk-main-container {
            width: 100%;
            max-width: 1320px;
            min-height: 65vh;
            margin: 0 auto;
            padding: 28px 18px 45px;
        }

        .vdk-alert-container {
            width: 100%;
            max-width: 1320px;
            margin: 0 auto;
            padding: 18px 18px 0;
        }

        .vdk-alert {
            margin: 0;
            padding: 13px 16px;
            border: 0;
            border-radius: 14px;
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
        }

        .vdk-footer {
            margin-top: auto;
            padding: 42px 0 18px;
            background:
                radial-gradient(
                    circle at top left,
                    rgba(37, 99, 235, 0.25),
                    transparent 34%
                ),
                var(--vdk-footer);
            color: #cbd5e1;
        }

        .vdk-footer-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #ffffff;
            font-size: 16px;
            font-weight: 800;
        }

        .vdk-footer-description {
            max-width: 410px;
            margin-top: 13px;
            color: #94a3b8;
            font-size: 13px;
            line-height: 1.75;
        }

        .vdk-footer-title {
            margin-bottom: 14px;
            color: #ffffff;
            font-size: 14px;
            font-weight: 750;
        }

        .vdk-footer-link {
            margin-bottom: 9px;
            color: #94a3b8;
            display: block;
            font-size: 13px;
            transition: color 0.2s ease;
        }

        .vdk-footer-link:hover {
            color: #ffffff;
        }

        .vdk-footer-contact {
            margin-bottom: 10px;
            color: #94a3b8;
            display: flex;
            align-items: flex-start;
            gap: 8px;
            font-size: 13px;
        }

        .vdk-footer-contact i {
            margin-top: 2px;
            color: #60a5fa;
        }

        .vdk-footer-bottom {
            margin-top: 32px;
            padding-top: 17px;
            border-top: 1px solid rgba(148, 163, 184, 0.16);
            color: #64748b;
            text-align: center;
            font-size: 11px;
        }

        @@media (max-width: 991.98px) {
            .vdk-navbar {
                position: relative;
            }

            .vdk-navbar .navbar-collapse {
                margin-top: 13px;
                padding: 12px;
                border: 1px solid var(--vdk-border);
                border-radius: 15px;
                background: #ffffff;
                box-shadow: 0 15px 35px rgba(15, 23, 42, 0.08);
            }

            .vdk-navbar .nav-link {
                margin: 2px 0;
            }

            .vdk-user-info {
                max-width: none;
            }

            .vdk-auth-actions {
                margin-top: 10px;
                display: grid !important;
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 575.98px) {
            .vdk-main-container {
                padding-right: 12px;
                padding-left: 12px;
            }

            .vdk-alert-container {
                padding-right: 12px;
                padding-left: 12px;
            }

            .vdk-brand-text small {
                display: none;
            }

            .vdk-footer {
                padding-top: 32px;
            }
        }
    </style>

    <style id="vdk-messagebox-styles">
        .swal2-container {
            z-index: 20050 !important;
            font-family:
                Inter,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;
        }

        .vdk-swal-popup {
            overflow: hidden !important;
            padding: 30px 28px 26px !important;
            border: 1px solid rgba(226, 232, 240, 0.95) !important;
            border-radius: 26px !important;
            background:
                radial-gradient(
                    circle at top right,
                    rgba(99, 102, 241, 0.12),
                    transparent 35%
                ),
                rgba(255, 255, 255, 0.99) !important;
            box-shadow:
                0 30px 90px rgba(15, 23, 42, 0.24),
                0 8px 24px rgba(15, 23, 42, 0.08) !important;
            backdrop-filter: blur(20px);
        }

        .vdk-swal-popup::before {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 6px;
            content: "";
            background:
                linear-gradient(
                    90deg,
                    #2563eb,
                    #7c3aed,
                    #06b6d4
                );
        }

        .vdk-swal-title {
            margin-top: 4px !important;
            color: #0f172a !important;
            font-size: 1.45rem !important;
            font-weight: 850 !important;
            letter-spacing: -0.025em !important;
        }

        .vdk-swal-content {
            margin-top: 8px !important;
            color: #475569 !important;
            font-size: 0.98rem !important;
            line-height: 1.65 !important;
        }

        .vdk-swal-confirm,
        .vdk-swal-cancel {
            min-width: 118px;
            min-height: 44px;
            margin: 6px;
            padding: 10px 20px;
            border: 0;
            border-radius: 13px;
            font-size: 0.93rem;
            font-weight: 750;
            transition:
                transform 0.18s ease,
                box-shadow 0.18s ease,
                opacity 0.18s ease;
        }

        .vdk-swal-confirm {
            color: #ffffff;
            background:
                linear-gradient(
                    135deg,
                    #2563eb,
                    #7c3aed
                );
            box-shadow:
                0 10px 24px rgba(37, 99, 235, 0.25);
        }

        .vdk-swal-cancel {
            border: 1px solid #dbe3ef;
            color: #475569;
            background: #f8fafc;
        }

        .vdk-swal-confirm:hover,
        .vdk-swal-cancel:hover {
            transform: translateY(-2px);
        }

        .vdk-swal-confirm:hover {
            box-shadow:
                0 14px 30px rgba(37, 99, 235, 0.34);
        }

        .vdk-swal-cancel:hover {
            background: #eef2f7;
        }

        .vdk-swal-toast-popup {
            width: min(400px, calc(100vw - 28px)) !important;
            padding: 17px 18px !important;
            border-radius: 18px !important;
            display: grid !important;
            grid-template-columns: auto 1fr !important;
            align-items: center !important;
            column-gap: 12px !important;
        }

        .vdk-swal-toast-popup::before {
            height: 4px;
        }

        .vdk-swal-toast-popup .swal2-icon {
            width: 38px !important;
            height: 38px !important;
            margin: 0 !important;
            font-size: 0.7rem !important;
        }

        .vdk-swal-toast-popup .vdk-swal-title {
            margin: 0 !important;
            padding: 0 !important;
            text-align: left !important;
            font-size: 1rem !important;
        }

        .vdk-swal-toast-popup .vdk-swal-content {
            grid-column: 2;
            margin: 3px 0 0 !important;
            padding: 0 !important;
            text-align: left !important;
            font-size: 0.86rem !important;
            line-height: 1.45 !important;
        }

        .vdk-swal-progress {
            height: 4px !important;
            background:
                linear-gradient(
                    90deg,
                    #2563eb,
                    #7c3aed
                ) !important;
        }

        @@media (max-width: 575.98px) {
            .vdk-swal-popup {
                width: calc(100vw - 24px) !important;
                padding: 25px 19px 21px !important;
                border-radius: 21px !important;
            }

            .vdk-swal-title {
                font-size: 1.25rem !important;
            }

            .vdk-swal-confirm,
            .vdk-swal-cancel {
                width: 100%;
                margin: 5px 0;
            }

            .vdk-swal-toast-popup {
                width: calc(100vw - 20px) !important;
            }
        }
    </style>

</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg vdk-navbar">
            <div class="container-fluid px-3 px-lg-4">
                <a class="navbar-brand"
                   asp-controller="Books"
                   asp-action="Index">

                    <span class="vdk-logo">
                        <i class="bi bi-book-half"></i>
                    </span>

                    <span class="vdk-brand-text">
                        VDK Book Rental

                        <small>
                            Hệ thống cho thuê sách
                        </small>
                    </span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#vdkMainNavbar"
                        aria-controls="vdkMainNavbar"
                        aria-expanded="false"
                        aria-label="Mở menu">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="vdkMainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link @ActiveClass("Books", "Index")"
                               asp-controller="Books"
                               asp-action="Index">

                                <i class="bi bi-house-door"></i>
                                Trang chủ
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @ActiveClass("Books")"
                               asp-controller="Books"
                               asp-action="Index">

                                <i class="bi bi-book"></i>
                                Kho sách
                            </a>
                        </li>

                        @if (isLoggedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("Rental", "Current")"
                                   asp-controller="Rental"
                                   asp-action="Current">

                                    <i class="bi bi-bag-check"></i>
                                    Sách đang thuê
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("Rental", "History")"
                                   asp-controller="Rental"
                                   asp-action="History">

                                    <i class="bi bi-clock-history"></i>
                                    Lịch sử thuê
                                </a>
                            </li>
                        }

                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("Admin")"
                                   asp-controller="Admin"
                                   asp-action="Index">

                                    <i class="bi bi-speedometer2"></i>
                                    Quản trị
                                </a>
                            </li>
                        }
                        else if (isStaff)
                        {
                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("Staff")"
                                   asp-controller="Staff"
                                   asp-action="Index">

                                    <i class="bi bi-person-workspace"></i>
                                    Nhân viên
                                </a>
                            </li>
                        }
                    </ul>

                    @if (isLoggedIn)
                    {
                        <div class="dropdown">
                            <button class="btn nav-link dropdown-toggle vdk-user-dropdown"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                <span class="vdk-user-avatar">
                                    @if (!string.IsNullOrWhiteSpace(avatarUrl))
                                    {
                                        <img src="@Url.Content(avatarUrl)"
                                             alt="Ảnh đại diện"
                                             onerror="this.style.display='none';" />
                                    }
                                    else
                                    {
                                        @initials
                                    }
                                </span>

                                <span class="vdk-user-info">
                                    <strong>@displayName</strong>

                                    <small>
                                        @(string.IsNullOrWhiteSpace(userRole)
                                            ? "Khách hàng"
                                            : userRole)
                                    </small>
                                </span>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end vdk-dropdown-menu">
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Profile"
                                       asp-action="Index">

                                        <i class="bi bi-person-circle"></i>
                                        Hồ sơ cá nhân
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Rental"
                                       asp-action="Current">

                                        <i class="bi bi-bag-check"></i>
                                        Đơn thuê hiện tại
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Rental"
                                       asp-action="History">

                                        <i class="bi bi-clock-history"></i>
                                        Lịch sử thuê sách
                                    </a>
                                </li>

                                @if (isAdmin)
                                {
                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Admin"
                                           asp-action="Index">

                                            <i class="bi bi-shield-lock"></i>
                                            Trang quản trị
                                        </a>
                                    </li>
                                }

                                @if (isStaff)
                                {
                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Staff"
                                           asp-action="Index">

                                            <i class="bi bi-person-workspace"></i>
                                            Trang nhân viên
                                        </a>
                                    </li>
                                }

                                <li>
                                    <hr class="dropdown-divider" />
                                </li>

                                <li>
                                    <a class="dropdown-item text-danger"
                                       asp-controller="Account"
                                       asp-action="Logout">

                                        <i class="bi bi-box-arrow-right"></i>
                                        Đăng xuất
                                    </a>
                                </li>
