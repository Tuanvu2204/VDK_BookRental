<section class="vdk-ai-widget"
         aria-label="Trợ lý AI VDK Book Rental">

    <!-- Nút mở ChatBox -->
    <button id="aiChatOpen"
            type="button"
            class="vdk-ai-launcher"
            aria-label="Mở trợ lý AI"
            aria-controls="aiChatPanel"
            aria-expanded="true">

        <span class="vdk-ai-launcher-icon">
            <i class="bi bi-stars"></i>
        </span>

        <span class="vdk-ai-launcher-text">
            Trợ lý AI
        </span>

        <span class="vdk-ai-launcher-pulse"></span>
    </button>

    <!-- Cửa sổ ChatBox -->
    <aside id="aiChatPanel"
           class="vdk-ai-panel is-open"
           aria-hidden="false">

        <!-- Header -->
        <header class="vdk-ai-header">

            <div class="vdk-ai-header-profile">

                <div class="vdk-ai-robot-avatar">
                    <span class="vdk-ai-robot-face">
                        <i class="bi bi-robot"></i>
                    </span>

                    <span class="vdk-ai-avatar-status"></span>
                </div>

                <div class="vdk-ai-header-info">
                    <h2 class="vdk-ai-title">
                        Trợ lý VDK AI
                    </h2>

                    <div class="vdk-ai-online-status">
                        <span class="vdk-ai-online-dot"></span>
                        Đang trực tuyến
                    </div>
                </div>

            </div>

            <div class="vdk-ai-header-actions">

                <button id="aiChatReset"
                        type="button"
                        class="vdk-ai-header-button"
                        title="Làm mới cuộc trò chuyện"
                        aria-label="Làm mới cuộc trò chuyện">

                    <i class="bi bi-arrow-clockwise"></i>
                </button>

                <button id="aiChatMinimize"
                        type="button"
                        class="vdk-ai-header-button"
                        title="Thu nhỏ"
                        aria-label="Thu nhỏ ChatBox">

                    <i class="bi bi-dash-lg"></i>
                </button>

                <button id="aiChatClose"
                        type="button"
                        class="vdk-ai-header-button"
                        title="Đóng"
                        aria-label="Đóng ChatBox">

                    <i class="bi bi-x-lg"></i>
                </button>

            </div>

        </header>

        <!-- Nội dung trò chuyện -->
        <div id="aiChatMessages"
             class="vdk-ai-messages"
             role="log"
             aria-live="polite">

            <!-- Tin nhắn chào mặc định -->
            <div class="vdk-ai-message assistant"
                 data-ai-static="true">

                <div class="vdk-ai-message-avatar">
                    <i class="bi bi-stars"></i>
                </div>

                <div class="vdk-ai-message-content">

                    <div class="vdk-ai-message-bubble">
                        <p>
                            Xin chào! Mình là
                            <strong>Trợ lý AI của VDK Book Rental</strong>
                            👋
                        </p>

                        <p>
                            Mình có thể giúp bạn tìm sách,
                            kiểm tra giá thuê, số lượng còn lại
                            và gợi ý sách phù hợp.
                        </p>
                    </div>

                    <span class="vdk-ai-message-time">
                        Vừa xong
                    </span>

                </div>

            </div>

        </div>

        <!-- Câu hỏi gợi ý -->
        <div class="vdk-ai-suggestions"
             aria-label="Câu hỏi gợi ý">

            <button type="button"
                    class="vdk-ai-suggestion"
                    data-ai-prompt="Hiện có những sách nào còn để thuê?">

                <i class="bi bi-bookshelf"></i>
                Sách còn thuê
            </button>

            <button type="button"
                    class="vdk-ai-suggestion"
                    data-ai-prompt="Hãy gợi ý cho tôi một vài cuốn sách hay.">

                <i class="bi bi-stars"></i>
                Gợi ý sách
            </button>

            <button type="button"
                    class="vdk-ai-suggestion"
                    data-ai-prompt="Giá thuê của các sách hiện tại là bao nhiêu?">

                <i class="bi bi-cash-coin"></i>
                Giá thuê
            </button>

            <button type="button"
                    class="vdk-ai-suggestion"
                    data-ai-prompt="Hệ thống hiện có những thể loại sách nào?">

                <i class="bi bi-folder2-open"></i>
                Thể loại
            </button>

        </div>

        <!-- Form gửi tin nhắn -->
        <form id="aiChatForm"
              class="vdk-ai-form"
              autocomplete="off">

            <div class="vdk-ai-input-wrapper">

                <textarea id="aiChatInput"
                          class="vdk-ai-input"
                          rows="1"
                          maxlength="1000"
                          placeholder="Nhập tin nhắn của bạn..."
                          aria-label="Nhập câu hỏi cho trợ lý AI"></textarea>

                <div class="vdk-ai-input-actions">

                    <span id="aiChatCharacterCount"
                          class="vdk-ai-character-count">
                        0/1000
                    </span>

                    <button id="aiChatSend"
                            type="submit"
                            class="vdk-ai-send-button"
                            aria-label="Gửi tin nhắn">

                        <i class="bi bi-send-fill"></i>
                    </button>

                </div>

            </div>

        </form>

        <!-- Chú thích -->
        <footer class="vdk-ai-footer">
            <i class="bi bi-stars"></i>

            <span>
                Trợ lý AI có thể mắc sai sót.
                Vui lòng kiểm tra thông tin trước khi thuê sách.
            </span>
        </footer>

    </aside>

</section>