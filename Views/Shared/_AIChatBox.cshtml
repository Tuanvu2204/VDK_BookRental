<div id="vdkAiChat" class="ai-chat" aria-live="polite">
    <button id="aiChatToggle"
            class="ai-chat__toggle"
            type="button"
            aria-label="Mở trợ lý AI"
            aria-expanded="false">
        <span class="ai-chat__toggle-icon">✦</span>
        <span class="ai-chat__toggle-text">Trợ lý AI</span>
    </button>

    <section id="aiChatPanel"
             class="ai-chat__panel"
             aria-label="Trợ lý thuê sách"
             hidden>

        <header class="ai-chat__header">
            <div class="ai-chat__identity">
                <div class="ai-chat__avatar">AI</div>

                <div>
                    <h2>Trợ lý VDK</h2>

                    <p>
                        <span class="ai-chat__online-dot"></span>
                        Đang trực tuyến
                    </p>
                </div>
            </div>

            <div class="ai-chat__header-actions">
                <button id="aiChatClear"
                        class="ai-chat__icon-button"
                        type="button"
                        title="Xóa cuộc trò chuyện"
                        aria-label="Xóa cuộc trò chuyện">
                    ↻
                </button>

                <button id="aiChatClose"
                        class="ai-chat__icon-button"
                        type="button"
                        title="Đóng"
                        aria-label="Đóng chatbot">
                    ×
                </button>
            </div>
        </header>

        <div id="aiChatMessages"
             class="ai-chat__messages"
             role="log"
             aria-label="Nội dung trò chuyện">

            <div class="ai-chat__message ai-chat__message--assistant">
                <div class="ai-chat__message-avatar">AI</div>

                <div class="ai-chat__bubble">
                    Xin chào! Mình là trợ lý của VDK Book Rental.
                    Bạn có thể hỏi mình về sách, giá thuê hoặc cách thuê sách.
                </div>
            </div>
        </div>

        <div id="aiChatSuggestions" class="ai-chat__suggestions">
            <button type="button"
                    data-ai-suggestion="Hiện có những sách nào còn để thuê?">
                Sách còn để thuê
            </button>

            <button type="button"
                    data-ai-suggestion="Hướng dẫn tôi cách thuê sách.">
                Cách thuê sách
            </button>

            <button type="button"
                    data-ai-suggestion="Gợi ý cho tôi một cuốn sách giáo dục.">
                Gợi ý sách
            </button>
        </div>

        <form id="aiChatForm" class="ai-chat__form">
            <label class="visually-hidden" for="aiChatInput">
                Nhập nội dung cần hỏi
            </label>

            <textarea id="aiChatInput"
                      name="message"
                      rows="1"
                      maxlength="1000"
                      placeholder="Nhập câu hỏi của bạn..."
                      autocomplete="off"
                      required></textarea>

            <button id="aiChatSend"
                    class="ai-chat__send"
                    type="submit"
                    aria-label="Gửi tin nhắn">
                ➤
            </button>
        </form>

        <footer class="ai-chat__footer">
            Trợ lý AI có thể đưa ra thông tin chưa hoàn toàn chính xác.
        </footer>
    </section>
</div>