@section Scripts {
    <script>
        (() => {
            "use strict";

            const form = document.getElementById("bookRentalForm");

            if (!form) {
                return;
            }

            const rentalDaysInput =
                document.getElementById("rentalDays");

            const decreaseButton =
                document.getElementById("decreaseRentalDays");

            const increaseButton =
                document.getElementById("increaseRentalDays");

            const submitButton =
                document.getElementById("rentBookButton");

            const daysMessage =
                document.getElementById("rentalDaysMessage");

            const daysHelp =
                document.getElementById("rentalDaysHelp");

            const summaryDays =
                document.getElementById("summaryRentalDays");

            const summaryReturnDate =
                document.getElementById("summaryReturnDate");

            const summaryTotal =
                document.getElementById("summaryTotalAmount");

            const dayChips =
                document.querySelectorAll("[data-rental-days]");

            const dailyPrice =
                Number.parseFloat(form.dataset.dailyPrice ?? "0");

            let isSubmitting = false;

            function formatMoney(value) {
                return new Intl.NumberFormat("vi-VN").format(value) + " VNĐ";
            }

            function formatDate(value) {
                return new Intl.DateTimeFormat(
                    "vi-VN",
                    {
                        day: "2-digit",
                        month: "2-digit",
                        year: "numeric"
                    }
                ).format(value);
            }

            function getRentalDays() {
                return Number.parseInt(rentalDaysInput.value, 10);
            }

            function isValidRentalDays(days) {
                return Number.isInteger(days) &&
                    days >= 1 &&
                    days <= 30;
            }

            function updateActiveChip(days) {
                dayChips.forEach(chip => {
                    const chipDays =
                        Number.parseInt(chip.dataset.rentalDays ?? "0", 10);

                    chip.classList.toggle(
                        "active",
                        chipDays === days
                    );
                });
            }

            function updateRentalSummary() {
                const days = getRentalDays();
                const valid = isValidRentalDays(days);

                rentalDaysInput.classList.toggle(
                    "is-invalid",
                    !valid
                );

                daysHelp?.classList.toggle(
                    "is-error",
                    !valid
                );

                submitButton.disabled =
                    !valid || isSubmitting;

                if (!valid) {
                    daysMessage.textContent =
                        "Số ngày thuê phải từ 1 đến 30.";

                    summaryDays.textContent =
                        "Không hợp lệ";

                    summaryReturnDate.textContent =
                        "--/--/----";

                    summaryTotal.textContent =
                        "0 VNĐ";

                    updateActiveChip(-1);

                    return;
                }

                daysMessage.textContent =
                    `Bạn đang chọn thuê trong ${days} ngày.`;

                summaryDays.textContent =
                    `${days} ngày`;

                const returnDate = new Date();

                returnDate.setDate(
                    returnDate.getDate() + days
                );

                summaryReturnDate.textContent =
                    formatDate(returnDate);

                summaryTotal.textContent =
                    formatMoney(dailyPrice * days);

                updateActiveChip(days);
            }

            function setRentalDays(days) {
                const safeDays =
                    Math.min(30, Math.max(1, days));

                rentalDaysInput.value =
                    safeDays.toString();

                updateRentalSummary();
            }

            decreaseButton?.addEventListener(
                "click",
                () => {
                    const days = getRentalDays();

                    setRentalDays(
                        isValidRentalDays(days)
                            ? days - 1
                            : 1
                    );
                }
            );

            increaseButton?.addEventListener(
                "click",
                () => {
                    const days = getRentalDays();

                    setRentalDays(
                        isValidRentalDays(days)
                            ? days + 1
                            : 1
                    );
                }
            );

            rentalDaysInput.addEventListener(
                "input",
                updateRentalSummary
            );

            rentalDaysInput.addEventListener(
                "blur",
                () => {
                    const days = getRentalDays();

                    if (!isValidRentalDays(days)) {
                        setRentalDays(1);
                    }
                }
            );

            dayChips.forEach(chip => {
                chip.addEventListener(
                    "click",
                    () => {
                        const days =
                            Number.parseInt(
                                chip.dataset.rentalDays ?? "1",
                                10
                            );

                        setRentalDays(days);
                    }
                );
            });

            form.addEventListener(
                "submit",
                event => {
                    const days = getRentalDays();

                    if (!isValidRentalDays(days)) {
                        event.preventDefault();

                        updateRentalSummary();
                        rentalDaysInput.focus();

                        return;
                    }

                    if (isSubmitting) {
                        event.preventDefault();
                        return;
                    }

                    isSubmitting = true;
                    submitButton.disabled = true;

                    submitButton.innerHTML = `
                        <span class="rent-button-icon">
                            <i class="bi bi-arrow-repeat"></i>
                        </span>

                        <span class="rent-button-text">
                            <strong>Đang tạo đơn thuê...</strong>
                            <small>Vui lòng không đóng trình duyệt</small>
                        </span>

                        <span class="spinner-border spinner-border-sm ms-auto"
                              aria-hidden="true">
                        </span>
                    `;
                }
            );

            updateRentalSummary();
        })();
    </script>
}
