@model List<VDK_BookRental.Models.Book>

@{
    ViewData["Title"] = "Trang chủ";

    var educationBooks = Model
        .Where(x => x.Category != null && x.Category.Name == "Giáo dục")
        .ToList();

    var entertainmentBooks = Model
        .Where(x => x.Category != null && x.Category.Name == "Giải trí")
        .ToList();

    var sportBooks = Model
        .Where(x => x.Category != null && x.Category.Name == "Thể thao")
        .ToList();
}

<!-- ================= HERO ================= -->

<section class="book-hero">

    <div class="container">

        <div class="hero-content">

            <div class="hero-logo">

                <i class="bi bi-book-half"></i>

            </div>

            <h1>

                VDK BOOK RENTAL

            </h1>

            <p>

                Hệ thống thuê sách trực tuyến dành cho sinh viên.
                Khám phá hàng trăm đầu sách chất lượng với chi phí tiết kiệm.

            </p>

            <div class="search-box">

                <select id="categorySelect"
                        class="form-select">

                    <option value="all">

                        📚 Tất cả danh mục

                    </option>

                    <option value="Giáo dục">

                        📘 Giáo dục

                    </option>

                    <option value="Giải trí">

                        🎭 Giải trí

                    </option>

                    <option value="Thể thao">

                        ⚽ Thể thao

                    </option>

                </select>

                <input type="text"
                       id="searchInput"
                       class="form-control"
                       placeholder="Nhập tên sách hoặc tác giả..." />

                <button id="searchButton"
                        type="button"
                        class="btn btn-warning">

                    <i class="bi bi-search"></i>

                    Tìm kiếm

                </button>

            </div>

            <div class="search-hint">

                Hiện có

                <strong>

                    @Model.Count()

                </strong>

                đầu sách trong hệ thống

            </div>

        </div>

    </div>

</section>

<!-- ================= THỐNG KÊ ================= -->

<section class="statistics-section">

    <div class="container">

        <div class="row g-4">

            <div class="col-lg-3 col-md-6">

                <div class="stat-card">

                    <i class="bi bi-book-half"></i>

                    <h2>

                        @Model.Count()

                    </h2>

                    <span>

                        Đầu sách

                    </span>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="stat-card">

                    <i class="bi bi-grid-fill"></i>

                    <h2>

                        3

                    </h2>

                    <span>

                        Danh mục

                    </span>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="stat-card">

                    <i class="bi bi-star-fill"></i>

                    <h2>

                        @Model.Count()

                    </h2>

                    <span>

                        Sách nổi bật

                    </span>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="stat-card">

                    <i class="bi bi-people-fill"></i>

                    <h2>

                        100+

                    </h2>

                    <span>

                        Người dùng

                    </span>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- ================= GIỚI THIỆU ================= -->

<section class="intro-section">

    <div class="container text-center">

        <h2>

            <i class="bi bi-stack"></i>

            Danh mục sách

        </h2>

        <p>

            Khám phá kho sách phong phú gồm sách Giáo dục,
            Giải trí và Thể thao với giao diện hiện đại,
            dễ tìm kiếm và dễ thuê.

        </p>

    </div>

</section>

<div class="container">

    <!-- ===== BẮT ĐẦU SÁCH GIÁO DỤC ===== -->
    <!-- ================= SÁCH GIÁO DỤC ================= -->

    <div class="category-section">

        <div class="category-header">

            <div>

                <h2>📘 Sách Giáo dục</h2>

                <p>
                    Các đầu sách phục vụ học tập, nghiên                cứu và phát triển kỹ năng.
                </p>

            </div>

            <a asp-controller="Books"
               asp-action="Index"
               class="btn btn-outline-primary">

                Xem tất cả

            </a>

        </div>

        @if (educationBooks.Any())
        {

            <div class="row g-4">

                @foreach (var book in educationBooks)
                {

                    <div class="col-xl-3 col-lg-4 col-md-6 book-item"
                         data-title="@book.Title.ToLower()"
                         data-author="@book.Author.ToLower()"
                         data-category="@book.Category!.Name.ToLower()">

                        <div class="card book-card h-100">

                            <div class="book-img-wrap">

                                <img src="@(string.IsNullOrWhiteSpace(book.ImageUrl)
                                                                             ? "/images/books/default-book.jpg"
                                                                             : book.ImageUrl)"
                                     class="card-img-top"
                                     alt="@book.Title"
                                     onerror="this.src='/images/books/default-book.jpg'" />

                            </div>

                            <div class="card-body book-body">

                                <span class="badge bg-primary mb-2">

                                    @book.Category.Name

                                </span>

                                <h5 class="card-title">

                                    @book.Title

                                </h5>

                                <p class="text-muted mb-2">

                                    <i class="bi bi-person-fill"></i>

                                    @book.Author

                                </p>

                                <div class="mb-3">

                                    <span class="fw-bold text-primary fs-5">

                                        @book.RentalPrice.ToString("N0") VNĐ

                                    </span>

                                    <small class="text-muted">

                                        / ngày

                                    </small>

                                </div>

                                <div class="d-grid gap-2">

                                    <a asp-controller="Books"
                                       asp-action="Details"
                                       asp-route-id="@book.Id"
                                       class="btn btn-primary">

                                        <i class="bi bi-eye-fill me-1"></i>

                                        Xem chi tiết

                                    </a>

                                    <a href="#"
                                       class="btn btn-outline-success">

                                        <i class="bi bi-cart-plus-fill me-1"></i>

                                        Thuê ngay

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                }

            </div>

        }
        else
        {

            <div class="empty-category">

                <i class="bi bi-journal-x"></i>

                <h4>Chưa có sách Giáo dục</h4>

                <p>

                    Hiện chưa có dữ liệu trong danh mục này.

                </p>

            </div>

        }

        <div class="text-center mt-4">

            <a asp-controller="Books"
               asp-action="Index"
               class="btn btn-primary btn-lg px-5">

                Xem thêm sách

            </a>

        </div>

    </div>

    <!-- ===== BẮT ĐẦU SÁCH GIẢI TRÍ ===== -->
    <!-- ================= SÁCH GIẢI TRÍ ================= -->

    <div class="category-section">

        <div class="category-header">

            <div>

                <h2>🎭 Sách Giải trí</h2>

                <p>

                    Tiểu thuyết, truyện tranh, văn học và những đầu sách thư giãn hấp dẫn.

                </p>

            </div>

            <a asp-controller="Books"
               asp-action="Index"
               class="btn btn-outline-primary">

                Xem tất cả

            </a>

        </div>

        @if (entertainmentBooks.Any())
        {

            <div class="row g-4">

                @foreach (var book in entertainmentBooks)
                {

                    <div class="col-xl-3 col-lg-4 col-md-6 book-item"
                         data-title="@book.Title.ToLower()"
                         data-author="@book.Author.ToLower()"
                         data-category="@book.Category!.Name.ToLower()">

                        <div class="card book-card h-100">

                            <div class="book-img-wrap">

                                <img src="@(string.IsNullOrWhiteSpace(book.ImageUrl)
                                                                             ? "/images/books/default-book.jpg"
                                                                             : book.ImageUrl)"
                                     class="card-img-top"
                                     alt="@book.Title"
                                     onerror="this.src='/images/books/default-book.jpg'" />

                            </div>

                            <div class="card-body book-body">

                                <span class="badge bg-warning text-dark mb-2">

                                    @book.Category.Name

                                </span>

                                <h5 class="card-title">

                                    @book.Title

                                </h5>

                                <p class="text-muted mb-2">

                                    <i class="bi bi-person-fill me-1"></i>

                                    @book.Author

                                </p>

                                <div class="mb-3">

                                    <span class="fw-bold text-primary fs-5">

                                        @book.RentalPrice.ToString("N0") VNĐ

                                    </span>

                                    <small class="text-muted">

                                        / ngày

                                    </small>

                                </div>

                                <div class="d-grid gap-2">

                                    <a asp-controller="Books"
                                       asp-action="Details"
                                       asp-route-id="@book.Id"
                                       class="btn btn-primary">

                                        <i class="bi bi-eye-fill me-1"></i>

                                        Xem chi tiết

                                    </a>

                                    <a href="#"
                                       class="btn btn-outline-success">

                                        <i class="bi bi-cart-plus-fill me-1"></i>

                                        Thuê ngay

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                }

            </div>

        }
        else
        {

            <div class="empty-category">

                <i class="bi bi-emoji-smile"></i>

                <h4>Chưa có sách Giải trí</h4>

                <p>

                    Danh mục này sẽ được cập nhật trong thời gian tới.

                </p>

            </div>

        }

        <div class="text-center mt-4">

            <a asp-controller="Books"
               asp-action="Index"
               class="btn btn-primary btn-lg px-5">

                Xem thêm sách

            </a>

        </div>

    </div>

    <!-- ===== BẮT ĐẦU SÁCH THỂ THAO ===== -->
    <!-- ================= SÁCH THỂ THAO ================= -->

    <div class="category-section">

        <div class="category-header">

            <div>

                <h2>⚽ Sách Thể thao</h2>

                <p>

                    Kiến thức về luyện tập, dinh dưỡng, chiến thuật và các môn thể thao hiện đại.

                </p>

            </div>

            <a asp-controller="Books"
               asp-action="Index"
               class="btn btn-outline-primary">

                Xem tất cả

            </a>

        </div>

        @if (sportBooks.Any())
        {

            <div class="row g-4">

                @foreach (var book in sportBooks)
                {

                    <div class="col-xl-3 col-lg-4 col-md-6 book-item"
                         data-title="@book.Title.ToLower()"
                         data-author="@book.Author.ToLower()"
                         data-category="@book.Category!.Name.ToLower()">

                        <div class="card book-card h-100">

                            <div class="book-img-wrap">

                                <img src="@(string.IsNullOrWhiteSpace(book.ImageUrl)
                                                                     ? "/images/books/default-book.jpg"
                                                                     : book.ImageUrl)"
                                     class="card-img-top"
                                     alt="@book.Title"
                                     onerror="this.src='/images/books/default-book.jpg'" />

                            </div>

                            <div class="card-body book-body">

                                <span class="badge bg-success mb-2">

                                    @book.Category.Name

                                </span>

                                <h5 class="card-title">

                                    @book.Title

                                </h5>

                                <p class="text-muted mb-2">

                                    <i class="bi bi-person-fill me-1"></i>

                                    @book.Author

                                </p>

                                <div class="mb-3">

                                    <span class="fw-bold text-primary fs-5">

                                        @book.RentalPrice.ToString("N0") VNĐ

                                    </span>

                                    <small class="text-muted">

                                        / ngày

                                    </small>

                                </div>

                                <div class="d-grid gap-2">

                                    <a asp-controller="Books"
                                       asp-action="Details"
                                       asp-route-id="@book.Id"
                                       class="btn btn-primary">

                                        <i class="bi bi-eye-fill me-1"></i>

                                        Xem chi tiết

                                    </a>

                                    <a href="#"
                                       class="btn btn-outline-success">

                                        <i class="bi bi-cart-plus-fill me-1"></i>

                                        Thuê ngay

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                }

            </div>

        }
        else
        {

            <div class="empty-category">

                <i class="bi bi-trophy-fill"></i>

                <h4>Chưa có sách Thể thao</h4>

                <p>

                    Danh mục này sẽ được cập nhật trong thời gian tới.

                </p>

            </div>

        }

        <div class="text-center mt-4 mb-5">

            <a asp-controller="Books"
               asp-action="Index"
               class="btn btn-primary btn-lg px-5">

                Xem thêm sách

            </a>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const input = document.getElementById("searchInput");
            const category = document.getElementById("categorySelect");
            const button = document.getElementById("searchButton");
            const hint = document.getElementById("searchHint");

            function filterBooks() {

                const keyword = input.value.toLowerCase().trim();
                const cate = category.value.toLowerCase();

                let visible = 0;

                document.querySelectorAll(".book-item").forEach(function(item){

                    const title = item.dataset.title;
                    const author = item.dataset.author;
                    const c = item.dataset.category;

                    const matchKeyword =
                        title.includes(keyword) ||
                        author.includes(keyword);

                    const matchCategory =
                        cate === "all" || c === cate;

                    if(matchKeyword && matchCategory){

                        item.style.display="";

                        visible++;

                    }
                    else{

                        item.style.display="none";

                    }

                });

                hint.innerHTML =
                    "Tìm thấy <strong>" + visible + "</strong> cuốn sách";

            }

            button.addEventListener("click", filterBooks);

            input.addEventListener("keyup", function(e){

                if(e.key==="Enter"){

                    filterBooks();

                }

            });

            category.addEventListener("change", filterBooks);

        });

    </script>

}