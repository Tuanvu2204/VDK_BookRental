@model IEnumerable<VDK_BookRental.Models.Book>

@{
    ViewData["Title"] = "Quản lý sách";
}

<style>
    .book-admin-page {
        min-height: 75vh;
        background: #f5f7fb;
    }

    .book-admin-header {
        border-radius: 20px;
        padding: 24px;
        background: linear-gradient(135deg, #ffb300, #ff7a00);
        color: white;
        box-shadow: 0 10px 28px rgba(255, 145, 0, 0.2);
    }

    .book-table-card {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 8px 26px rgba(30, 42, 70, 0.08);
    }

    .book-cover-admin {
        width: 72px;
        height: 96px;
        object-fit: contain;
        border-radius: 8px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
    }

    .book-title-admin {
        min-width: 180px;
        font-weight: 700;
    }

    .admin-action-group {
        min-width: 150px;
    }
</style>

<div class="book-admin-page py-5">

    <div class="container">

        <!-- TIÊU ĐỀ -->
        <div class="book-admin-header mb-4">

            <div class="row align-items-center gy-3">

                <div class="col-lg-7">

                    <h1 class="fw-bold mb-2">
                        📚 Quản lý sách
                    </h1>

                    <p class="mb-0 opacity-75">
                        Thêm, sửa, xóa và cập nhật số lượng sách trong hệ thống.
                    </p>

                </div>

                <div class="col-lg-5 text-lg-end">

                    <a asp-controller="Admin"
                       asp-action="CreateBook"
                       class="btn btn-light fw-bold me-2">

                        ➕ Thêm sách mới

                    </a>

                    <a asp-controller="Admin"
                       asp-action="Index"
                       class="btn btn-outline-light">

                        ← Dashboard

                    </a>

                </div>

            </div>

        </div>

        <!-- THÔNG BÁO -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">

                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">

                @TempData["ErrorMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }

        <!-- BẢNG SÁCH -->
        <div class="card book-table-card">

            <div class="card-body p-4">

                @if (Model == null || !Model.Any())
                {
                    <div class="text-center py-5">

                        <div class="display-3 mb-3">
                            📭
                        </div>

                        <h4 class="fw-bold">
                            Chưa có sách trong hệ thống
                        </h4>

                        <p class="text-muted">
                            Hãy thêm quyển sách đầu tiên.
                        </p>

                        <a asp-controller="Admin"
                           asp-action="CreateBook"
                           class="btn btn-success">

                            Thêm sách mới

                        </a>

                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-bordered table-hover align-middle">

                            <thead class="table-dark">

                                <tr>
                                    <th class="text-center">Ảnh</th>
                                    <th>Tên sách</th>
                                    <th>Tác giả</th>
                                    <th>Danh mục</th>
                                    <th class="text-end">Giá thuê</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-center">Trạng thái</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var book in Model)
                                {
                                    <tr>

                                        <td class="text-center">

                                            <img src="@(string.IsNullOrWhiteSpace(book.ImageUrl)
                                                                                                            ? "/images/books/default-book.jpg"
                                                                                                            : book.ImageUrl)"
                                                 alt="@book.Title"
                                                 class="book-cover-admin"
                                                 onerror="this.src='/images/books/default-book.jpg'" />

                                        </td>

                                        <td class="book-title-admin">

                                            @book.Title

                                        </td>

                                        <td>

                                            @book.Author

                                        </td>

                                        <td>

                                            @if (book.Category != null)
                                            {
                                                <span class="badge bg-info text-dark">

                                                    @book.Category.Name

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">

                                                    Chưa phân loại

                                                </span>
                                            }

                                        </td>

                                        <td class="text-end fw-bold text-success">

                                            @book.RentalPrice.ToString("N0") VNĐ

                                        </td>

                                        <td class="text-center">

                                            <span class="fw-bold">
                                                @book.Quantity
                                            </span>

                                        </td>

                                        <td class="text-center">

                                            @if (book.Quantity > 0)
                                            {
                                                <span class="badge bg-success">

                                                    Còn sách

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">

                                                    Hết sách

                                                </span>
                                            }

                                        </td>

                                        <td class="admin-action-group">

                                            <div class="d-flex justify-content-center gap-2">

                                                <a asp-controller="Admin"
                                                   asp-action="EditBook"
                                                   asp-route-id="@book.Id"
                                                   class="btn btn-sm btn-warning">

                                                    ✏️ Sửa

                                                </a>

                                                <form asp-controller="Admin"
                                                      asp-action="DeleteBook"
                                                      method="post"
                                                      onsubmit="return confirm('Bạn chắc chắn muốn xóa sách này?');">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@book.Id" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-danger">

                                                        🗑 Xóa

                                                    </button>

                                                </form>

                                            </div>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>

    </div>

</div>