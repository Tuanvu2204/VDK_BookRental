@model VDK_BookRental.ViewModels.BookFormViewModel

@{
    ViewData["Title"] = "Thêm sách mới";

    var categories =
        ViewBag.Categories as IEnumerable<VDK_BookRental.Models.Category>;
}

<style>
    .book-form-page {
        min-height: 75vh;
        background: #f5f7fb;
    }

    .book-form-card {
        border: none;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 12px 34px rgba(26, 39, 70, 0.1);
    }

    .book-form-header {
        padding: 24px 28px;
        background: linear-gradient(135deg, #198754, #0f5132);
        color: white;
    }

    .image-upload-box {
        position: relative;
        padding: 24px;
        border: 2px dashed #aeb8c4;
        border-radius: 18px;
        background: #f9fbfd;
        text-align: center;
        transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
    }

        .image-upload-box:hover {
            border-color: #198754;
            background: #f1fbf5;
            box-shadow: 0 8px 20px rgba(25, 135, 84, 0.08);
        }

        .image-upload-box.dragging {
            border-color: #198754;
            background: #e8f8ef;
            box-shadow: 0 0 0 4px rgba(25, 135, 84, 0.12);
        }

    .image-preview-wrapper {
        display: none;
        margin-top: 20px;
    }

        .image-preview-wrapper.show {
            display: block;
        }

    .image-preview {
        width: 220px;
        height: 300px;
        object-fit: contain;
        border: 1px solid #dee2e6;
        border-radius: 16px;
        background: #ffffff;
        padding: 10px;
        box-shadow: 0 8px 22px rgba(23, 35, 58, 0.09);
    }

    .selected-file-info {
        margin-top: 12px;
        color: #495057;
        font-size: 14px;
    }

    .form-control,
    .form-select {
        min-height: 48px;
        border-radius: 12px;
    }

    textarea.form-control {
        min-height: 150px;
    }

    .form-action-button {
        min-height: 48px;
        border-radius: 12px;
        font-weight: 700;
    }
</style>

<div class="book-form-page py-5">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-xl-9 col-lg-10">

                <div class="card book-form-card">

                    <div class="book-form-header">

                        <h1 class="fw-bold mb-2">
                            ➕ Thêm sách mới
                        </h1>

                        <p class="mb-0 opacity-75">
                            Nhập thông tin sách và chọn ảnh bìa từ máy tính.
                        </p>

                    </div>

                    <div class="card-body p-4 p-lg-5">

                        <form asp-controller="Admin"
                              asp-action="CreateBook"
                              method="post"
                              enctype="multipart/form-data">

                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly"
                                 class="alert alert-danger"></div>

                            <div class="row g-4">

                                <div class="col-lg-7">

                                    <div class="mb-3">

                                        <label asp-for="Title"
                                               class="form-label fw-bold">
                                            Tên sách
                                        </label>

                                        <input asp-for="Title"
                                               class="form-control"
                                               placeholder="Nhập tên sách..." />

                                        <span asp-validation-for="Title"
                                              class="text-danger"></span>

                                    </div>

                                    <div class="mb-3">

                                        <label asp-for="Author"
                                               class="form-label fw-bold">
                                            Tác giả
                                        </label>

                                        <input asp-for="Author"
                                               class="form-control"
                                               placeholder="Nhập tên tác giả..." />

                                        <span asp-validation-for="Author"
                                              class="text-danger"></span>

                                    </div>

                                    <div class="mb-3">

                                        <label asp-for="CategoryId"
                                               class="form-label fw-bold">
                                            Danh mục
                                        </label>

                                        <select asp-for="CategoryId"
                                                class="form-select">

                                            <option value="">
                                                -- Chọn danh mục --
                                            </option>

                                            @if (categories != null)
                                            {
                                                foreach (var category in categories)
                                                {
                                                    <option value="@category.Id">
                                                        @category.Name
                                                    </option>
                                                }
                                            }

                                        </select>

                                        <span asp-validation-for="CategoryId"
                                              class="text-danger"></span>

                                    </div>

                                    <div class="row">

                                        <div class="col-md-6 mb-3">

                                            <label asp-for="RentalPrice"
                                                   class="form-label fw-bold">
                                                Giá thuê mỗi ngày
                                            </label>

                                            <div class="input-group">

                                                <input asp-for="RentalPrice"
                                                       type="number"
                                                       min="0"
                                                       step="1000"
                                                       class="form-control" />

                                                <span class="input-group-text">
                                                    VNĐ
                                                </span>

                                            </div>

                                            <span asp-validation-for="RentalPrice"
                                                  class="text-danger"></span>

                                        </div>

                                        <div class="col-md-6 mb-3">

                                            <label asp-for="Quantity"
                                                   class="form-label fw-bold">
                                                Số lượng
                                            </label>

                                            <input asp-for="Quantity"
                                                   type="number"
                                                   min="0"
                                                   class="form-control" />

                                            <span asp-validation-for="Quantity"
                                                  class="text-danger"></span>

                                        </div>

                                    </div>

                                    <div class="mb-3">

                                        <label asp-for="Description"
                                               class="form-label fw-bold">
                                            Mô tả
                                        </label>

                                        <textarea asp-for="Description"
                                                  class="form-control"
                                                  rows="6"
                                                  placeholder="Nhập mô tả sách..."></textarea>

                                        <span asp-validation-for="Description"
                                              class="text-danger"></span>

                                    </div>

                                </div>

                                <div class="col-lg-5">

                                    <label class="form-label fw-bold">
                                        Ảnh bìa sách
                                    </label>

                                    <div id="imageUploadBox"
                                         class="image-upload-box">

                                        <div class="fs-1 mb-3">
                                            📁
                                        </div>

                                        <h5 class="fw-bold">
                                            Chọn ảnh từ máy tính
                                        </h5>

                                        <p class="text-muted mb-3">
                                            JPG, JPEG, PNG hoặc WEBP<br />
                                            Dung lượng tối đa 5 MB
                                        </p>

                                        <label for="ImageFile"
                                               class="btn btn-success">

                                            Chọn ảnh

                                        </label>

                                        <input asp-for="ImageFile"
                                               id="ImageFile"
                                               type="file"
                                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                               class="d-none" />

                                        <div class="selected-file-info">

                                            <div id="selectedFileName">
                                                Chưa chọn file
                                            </div>

                                            <div id="selectedFileSize"
                                                 class="text-muted">
                                            </div>

                                        </div>

                                        <div id="imagePreviewWrapper"
                                             class="image-preview-wrapper">

                                            <img id="imagePreview"
                                                 class="image-preview"
                                                 alt="Xem trước ảnh sách" />

                                            <div class="mt-3">

                                                <button type="button"
                                                        id="removeImageButton"
                                                        class="btn btn-outline-danger btn-sm">

                                                    Xóa ảnh đã chọn

                                                </button>

                                            </div>

                                        </div>

                                    </div>

                                    <span asp-validation-for="ImageFile"
                                          class="text-danger d-block mt-2"></span>

                                </div>

                            </div>

                            <hr class="my-4" />

                            <div class="d-flex gap-3 flex-wrap">

                                <button type="submit"
                                        class="btn btn-success form-action-button px-4">

                                    Lưu sách

                                </button>

                                <a asp-controller="Admin"
                                   asp-action="Books"
                                   class="btn btn-outline-secondary form-action-button px-4">

                                    Hủy

                                </a>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        const imageInput =
            document.getElementById("ImageFile");

        const imageUploadBox =
            document.getElementById("imageUploadBox");

        const imagePreviewWrapper =
            document.getElementById("imagePreviewWrapper");

        const imagePreview =
            document.getElementById("imagePreview");

        const selectedFileName =
            document.getElementById("selectedFileName");

        const selectedFileSize =
            document.getElementById("selectedFileSize");

        const removeImageButton =
            document.getElementById("removeImageButton");

        const allowedTypes = [
            "image/jpeg",
            "image/png",
            "image/webp"
        ];

        const maximumSize =
            5 * 1024 * 1024;

        function formatFileSize(bytes) {

            if (bytes < 1024) {
                return `${bytes} bytes`;
            }

            if (bytes < 1024 * 1024) {
                return `${(bytes / 1024).toFixed(1)} KB`;
            }

            return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
        }

        function clearSelectedImage() {

            imageInput.value = "";

            imagePreview.removeAttribute("src");

            imagePreviewWrapper.classList.remove("show");

            selectedFileName.textContent =
                "Chưa chọn file";

            selectedFileSize.textContent = "";
        }

        function showSelectedImage(file) {

            if (!file) {
                clearSelectedImage();
                return;
            }

            if (!allowedTypes.includes(file.type)) {

                alert(
                    "Chỉ chấp nhận ảnh JPG, JPEG, PNG hoặc WEBP."
                );

                clearSelectedImage();

                return;
            }

            if (file.size > maximumSize) {

                alert(
                    "Dung lượng ảnh không được vượt quá 5 MB."
                );

                clearSelectedImage();

                return;
            }

            selectedFileName.textContent =
                file.name;

            selectedFileSize.textContent =
                formatFileSize(file.size);

            const reader =
                new FileReader();

            reader.onload = function (event) {

                imagePreview.src =
                    event.target.result;

                imagePreviewWrapper.classList.add("show");
            };

            reader.readAsDataURL(file);
        }

        imageInput.addEventListener(
            "change",
            function () {

                const file =
                    this.files && this.files.length > 0
                        ? this.files[0]
                        : null;

                showSelectedImage(file);
            }
        );

        removeImageButton.addEventListener(
            "click",
            clearSelectedImage
        );

        imageUploadBox.addEventListener(
            "dragover",
            function (event) {

                event.preventDefault();

                imageUploadBox.classList.add("dragging");
            }
        );

        imageUploadBox.addEventListener(
            "dragleave",
            function () {

                imageUploadBox.classList.remove("dragging");
            }
        );

        imageUploadBox.addEventListener(
            "drop",
            function (event) {

                event.preventDefault();

                imageUploadBox.classList.remove("dragging");

                const files =
                    event.dataTransfer.files;

                if (!files || files.length === 0) {
                    return;
                }

                const dataTransfer =
                    new DataTransfer();

                dataTransfer.items.add(files[0]);

                imageInput.files =
                    dataTransfer.files;

                showSelectedImage(files[0]);
            }
        );
    </script>

}